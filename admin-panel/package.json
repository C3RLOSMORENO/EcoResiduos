{
    "name": "eco-admin-panel",
    "version": "1.0.0",
    "description": "Panel de administración para la gestión de residuos de Santander",
    "main": "server.js",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "start": "node server.js",
        "build": "npm run build:css",
        "dev": "nodemon server.js",
        "dev:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --watch",
        "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --minify",
        "test": "node --test",
        "test:e2e": "playwright test",
        "lint": "eslint ."
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "chart.js": "4.4.4",
        "compression": "^1.8.2",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.4.5",
        "driver.js": "1.9.0",
        "ejs": "^3.1.10",
        "exceljs": "^4.4.0",
        "express": "^4.19.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
        "autoprefixer": "^10.5.4",
        "eslint": "^9.39.5",
        "globals": "^17.13.0",
        "nodemon": "^3.1.4",
        "postcss": "^8.5.26",
        "supertest": "^7.3.0",
        "tailwindcss": "^3.4.19"
    }
}
