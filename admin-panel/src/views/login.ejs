<!DOCTYPE html>
<html lang="es" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Acceso al panel administrativo de EcoResiduos Santander">
    <title>Iniciar Sesión - EcoManager Panel Santander</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            DEFAULT: '#1E4620',
                            hover: '#163518',
                            subtle: '#E8F0E6',
                        },
                        primary: '#1E4620',
                        'on-primary': '#FFFFFF',
                        'primary-container': '#2D5B30',
                        'surface-light': '#FFFFFF',
                        'surface-dark': '#1E293B',
                        'bg-light': '#F9FAFB',
                        'bg-dark': '#0F172A'
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>

<body class="min-h-screen w-full flex items-center justify-center bg-[#F9FAFB] dark:bg-[#0F172A] p-4 sm:p-6 lg:p-8 font-sans text-slate-900 dark:text-slate-100 antialiased">
    <main class="w-full max-w-md my-auto">
        <!-- Tarjeta de autenticación -->
        <div class="bg-white dark:bg-[#1E293B] rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xl p-8 sm:p-10 transition-all">
            <div class="flex flex-col items-center text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4 text-brand dark:text-emerald-400">
                    <span class="material-symbols-outlined text-4xl" aria-hidden="true">recycling</span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">EcoManager</h1>
                <p class="text-xs font-semibold text-brand dark:text-emerald-400 uppercase tracking-wider mt-1">Panel Santander</p>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">Ingresa tus credenciales para administrar el directorio de residuos y gestores autorizados.</p>
            </div>

            <%- include('partials/alert') %>

            <form action="/auth/login" method="POST" class="space-y-5" novalidate>
                <div>
                    <label for="email" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Correo Electrónico <span class="text-red-600" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
                        </div>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required 
                            autocomplete="email"
                            placeholder="admin@ecoresiduos.org"
                            class="input-ui !pl-11"
                        >
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                            Contraseña <span class="text-red-600" aria-hidden="true">*</span>
                        </label>
                        <a href="/restablecer-password" class="text-xs font-medium text-brand dark:text-emerald-400 hover:underline">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">lock</span>
                        </div>
                        <input 
                            type="password" 
                            id="password" 
                            name="password" 
                            required 
                            autocomplete="current-password"
                            placeholder="••••••••"
                            class="input-ui !pl-11 !pr-12"
                        >
                        <button 
                            type="button" 
                            id="toggle-password-btn" 
                            aria-label="Mostrar contraseña" 
                            aria-controls="password" 
                            aria-pressed="false"
                            class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 focus:outline-none rounded-lg transition-colors"
                        >
                            <span class="material-symbols-outlined text-xl select-none" id="toggle-password-icon" aria-hidden="true">visibility</span>
                        </button>
                    </div>
                </div>

                <div class="pt-2">
                    <button 
                        type="submit" 
                        id="login-submit-btn"
                        class="btn-primary w-full !h-11"
                    >
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">login</span>
                        <span>Ingresar al Panel</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <!-- Visibilidad de contraseña -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const togglePasswordBtn = document.getElementById('toggle-password-btn');
            const passwordInput = document.getElementById('password');
            const togglePasswordIcon = document.getElementById('toggle-password-icon');

            if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
                togglePasswordBtn.addEventListener('click', () => {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    const newType = isPassword ? 'text' : 'password';
                    
                    passwordInput.setAttribute('type', newType);
                    togglePasswordBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                    togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
                    togglePasswordIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
                    
                    passwordInput.focus();
                });
            }
        });
    </script>
</body>

</html>
