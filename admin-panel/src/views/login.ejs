<!DOCTYPE html>
<html lang="es-CO">
<head>
  <%- include('partials/head', { titulo: 'Iniciar sesión' }) %>
  <meta name="description" content="Acceso al panel de administración de EcoResiduos">
</head>
<body class="min-h-screen lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
  <a href="#contenido" class="saltar">Saltar al contenido</a>
  <%- include('partials/marca-acceso') %>
  <div class="flex min-h-screen flex-col lg:min-h-0">
  <header class="flex items-center justify-between gap-3 p-2 lg:justify-end">
    <%- include('partials/marca-compacta') %>
    <button type="button" id="botonTema" class="btn-icono" aria-pressed="false" aria-label="Modo oscuro">
      <span class="material-symbols-outlined" aria-hidden="true" data-icono-tema>dark_mode</span>
    </button>
  </header>
  <main id="contenido" tabindex="-1" class="flex flex-1 items-center justify-center px-4 pb-12">
    <div class="w-full max-w-md rounded-xl bg-surface-container-low p-6 md:p-10">
      <div class="mb-6 flex flex-col items-center gap-2 text-center">
        <h1 class="font-display text-headline-l text-on-surface">Inicia sesión</h1>
        <p class="text-body-m text-on-surface-variant">Entra con tu cuenta de administrador de EcoResiduos.</p>
      </div>

      <%- include('partials/alert') %>

      <form action="/auth/login" method="POST" class="flex flex-col gap-4" data-validar>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (volver) { %><input type="hidden" name="volver" value="<%= volver %>"><% } %>
        <div class="campo">
          <label for="email" class="campo-etiqueta">Correo <span class="campo-obligatorio">(obligatorio)</span></label>
          <input type="email" id="email" name="email" required autocomplete="username" inputmode="email" class="campo-control">
        </div>
        <div class="campo">
          <label for="password" class="campo-etiqueta">Contraseña <span class="campo-obligatorio">(obligatorio)</span></label>
          <div class="relative">
            <input type="password" id="password" name="password" required autocomplete="current-password" class="campo-control pr-14">
            <button type="button" id="botonVerClave" data-ver-clave="password" class="btn-icono absolute right-0.5 top-0.5" aria-label="Mostrar contraseña" aria-controls="password" aria-pressed="false">
              <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
            </button>
          </div>
        </div>
        <button type="submit" class="btn-filled mt-2 w-full" data-cargando="Ingresando…">
          <span class="material-symbols-outlined icono-20" aria-hidden="true">login</span>
          <span data-etiqueta>Ingresar</span>
        </button>
        <a href="/restablecer-password" class="btn-text self-center">¿Olvidaste tu contraseña?</a>
      </form>
    </div>
  </main>
  </div>
</body>
</html>
