<%- include('partials/header') %>

<div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
        <h2 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">Ciudadanos Registrados</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">Directorio de usuarios generadores de residuos en la aplicación.</p>
    </div>
</div>

<% if (locals.error) { %>
    <%- include('partials/alert', { type: 'error', message: error, title: 'Error' }) %>
<% } %>
<% if (locals.success) { %>
    <%- include('partials/alert', { type: 'success', message: success, title: 'Éxito' }) %>
<% } %>

<div class="bg-white dark:bg-[#1E293B] rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table id="tablaGeneradores" class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-600 dark:text-slate-400 font-medium border-b border-slate-200 dark:border-slate-700">
                <tr>
                    <th scope="col" class="px-6 py-4">Usuario</th>
                    <th scope="col" class="px-6 py-4">Documento / NIT</th>
                    <th scope="col" class="px-6 py-4">Contacto</th>
                    <th scope="col" class="px-6 py-4">Municipio</th>
                    <th scope="col" class="px-6 py-4">Fecha Registro</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                <% if (generadores && generadores.length > 0) { %>
                    <% generadores.forEach(user => { %>
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-900 dark:text-white">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-brand font-bold text-lg border border-slate-200 dark:border-slate-700">
                                        <%= user.nombre_completo_o_empresa ? user.nombre_completo_o_empresa.charAt(0).toUpperCase() : 'U' %>
                                    </div>
                                    <div>
                                        <p class="font-bold"><%= user.nombre_completo_o_empresa %></p>
                                        <p class="text-[11px] text-slate-500 font-mono"><%= user.usuario_id.substring(0, 8) %>...</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-600 dark:text-slate-300 font-mono text-xs">
                                <%= user.documento_nit %>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-slate-900 dark:text-slate-200"><%= user.email %></p>
                                <p class="text-slate-500 dark:text-slate-400 text-xs"><%= user.telefono %></p>
                            </td>
                            <td class="px-6 py-4 text-slate-600 dark:text-slate-300 uppercase text-xs font-semibold">
                                <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 px-2.5 py-1 bg-slate-50 dark:bg-slate-800">
                                    <span class="material-symbols-outlined text-[14px] text-slate-400">location_on</span>
                                    <%= user.municipio %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-slate-500 dark:text-slate-400 text-sm">
                                <%= user.created_at ? new Date(user.created_at).toLocaleDateString('es-CO') : '-' %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400 empty-state" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">
                            <span class="material-symbols-outlined text-4xl mb-3 opacity-50 block">group_off</span>
                            <p class="text-base font-medium">No hay ciudadanos registrados</p>
                            <p class="text-sm mt-1">Cuando los usuarios se registren en la aplicación móvil, aparecerán en este directorio.</p>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>

