<%- include('partials/header', { activeTab: 'generadores', titulo: 'Ciudadanos', recorrido: recorrido }) %>

<div class="flex flex-col gap-6">
  <div data-recorrido="ciudadanos">
    <h1 class="titulo-pagina">Ciudadanos</h1>
    <p class="mt-1 text-body-l text-on-surface-variant">Generadores registrados en la app y cuántos residuos han publicado. Datos personales protegidos por la Ley 1581 de 2012.</p>
  </div>

  <form method="GET" action="/ciudadanos" class="panel-filtros grid grid-cols-1 gap-4 md:grid-cols-3" role="search" aria-label="Filtrar ciudadanos">
    <div class="campo md:col-span-2">
      <label for="filtroCiudadano" class="campo-etiqueta">Buscar</label>
      <input type="search" id="filtroCiudadano" name="q" value="<%= filtros.q %>" class="campo-control" aria-describedby="filtroCiudadanoAyuda">
      <p id="filtroCiudadanoAyuda" class="campo-ayuda">Nombre, empresa o documento.</p>
    </div>
    <div class="campo">
      <label for="filtroMunicipioCiudadano" class="campo-etiqueta">Municipio</label>
      <select id="filtroMunicipioCiudadano" name="municipio" class="campo-control">
        <option value="">Todos los municipios</option>
        <% MUNICIPIOS.forEach(function (m) { %>
          <option value="<%= m %>" <%= filtros.municipio === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2 md:col-span-3">
      <a href="/ciudadanos" class="btn-text">Limpiar filtros</a>
      <button type="submit" class="btn-filled">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">filter_list</span>
        Filtrar
      </button>
    </div>
  </form>

  <% if (errorCarga) { %>
    <%- include('partials/componentes/estado-error', { titulo: 'No pudimos cargar los ciudadanos.', detalle: errorCarga, reintentar: urlActual }) %>
  <% } else if (generadores.length === 0) { %>
    <div class="tarjeta">
      <% if (filtros.q || filtros.municipio) { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'search_off', titulo: 'No encontramos ciudadanos con esos filtros', accion: { href: '/ciudadanos', texto: 'Limpiar filtros' } }) %>
      <% } else { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'group_off', titulo: 'Aún no hay ciudadanos registrados', texto: 'Cuando los generadores se registren en la app, aparecerán aquí.' }) %>
      <% } %>
    </div>
  <% } else { %>
    <div>
      <div class="tabla-contenedor" role="region" aria-labelledby="captionCiudadanos" tabindex="0">
        <table class="tabla">
          <caption id="captionCiudadanos">Ciudadanos registrados, del más reciente al más antiguo<%= filtros.municipio ? ' · ' + filtros.municipio : '' %></caption>
          <thead>
            <tr>
              <th scope="col">Nombre</th>
              <th scope="col">Documento</th>
              <th scope="col">Contacto</th>
              <th scope="col">Municipio</th>
              <th scope="col">Registro</th>
              <th scope="col" class="num">Publicaciones</th>
            </tr>
          </thead>
          <tbody>
            <% generadores.forEach(function (u) { %>
              <tr>
                <th scope="row"><%= f.textoODato(u.nombre_completo_o_empresa) %></th>
                <td><%= f.textoODato(u.documento_nit) %></td>
                <td>
                  <span class="block break-all"><%= f.textoODato(u.email) %></span>
                  <span class="block text-body-s text-on-surface-variant"><%= u.telefono || '' %></span>
                </td>
                <td><%= u.municipio ? f.capitalizar(u.municipio) : 'Sin dato' %></td>
                <td class="whitespace-nowrap"><%= f.fechaCorta(u.created_at) %></td>
                <td class="num">
                  <% if (u.publicaciones > 0) { %>
                    <a class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-label-s font-semibold bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 hover:border-primary/40 no-underline transition-colors" href="/solicitudes?generador=<%= u.id %>" aria-label="<%= u.publicaciones %> publicaciones de <%= u.nombre_completo_o_empresa %>">
                      <span><%= f.formatoNumero(u.publicaciones) %></span>
                      <span class="material-symbols-outlined icono-14" aria-hidden="true">open_in_new</span>
                    </a>
                  <% } else { %>
                    <span class="text-on-surface-variant text-body-s">0</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('partials/componentes/paginacion', { pag, nombre: 'ciudadanos' }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
