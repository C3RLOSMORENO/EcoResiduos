<%
  const creando = modo === 'crear';
  const tituloPagina = creando ? 'Nuevo material' : 'Editar ' + (material.nombre_comun || 'material');
  const accion = creando ? '/materiales/guardar' : '/materiales/edit/' + material.id;
%>
<%- include('partials/header', { activeTab: 'materiales', titulo: tituloPagina }) %>

<div class="flex flex-col gap-6">
  <nav aria-label="Ruta de navegación" class="text-body-m">
    <ol class="flex flex-wrap items-center gap-1" role="list">
      <li><a class="enlace" href="/materiales">Materiales</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-on-surface-variant"><%= creando ? 'Nuevo' : material.nombre_comun %></li>
    </ol>
  </nav>

  <div>
    <h1 class="titulo-pagina"><%= tituloPagina %></h1>
    <p class="mt-1 text-body-l text-on-surface-variant">Lo que escribas aquí lo ven los generadores en la app al publicar y en el detalle del residuo.</p>
  </div>

  <form action="<%= accion %>" method="POST" class="tarjeta flex flex-col gap-4" data-validar data-conservar>
    <p class="campo-ayuda">Los campos marcados con «obligatorio» se deben llenar.</p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="campo">
        <label for="codigo" class="campo-etiqueta">Código <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="text" id="codigo" name="codigo" required maxlength="20" value="<%= material.codigo || '' %>" data-format="uppercase"
               pattern="[A-Za-z0-9.\-_]+" data-mensaje-formato="Usa solo letras, números, punto, guion o guion bajo. Ejemplo: Y9.2 o RAEE-01."
               class="campo-control" aria-describedby="codigoAyuda">
        <p id="codigoAyuda" class="campo-ayuda">Ejemplo: Y8, Y9.2, A1160 o RAEE-01.</p>
      </div>
      <div class="campo md:col-span-2">
        <label for="nombre_comun" class="campo-etiqueta">Nombre común <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="text" id="nombre_comun" name="nombre_comun" required minlength="3" maxlength="150" value="<%= material.nombre_comun || '' %>" class="campo-control">
      </div>
      <div class="campo">
        <label for="categoria" class="campo-etiqueta">Categoría <span class="campo-obligatorio">(obligatorio)</span></label>
        <select id="categoria" name="categoria" required class="campo-control">
          <option value="">Elige una categoría</option>
          <% f.CATEGORIAS_CATALOGO.forEach(function (c) { %>
            <option value="<%= c %>" <%= String(material.categoria || '').toUpperCase() === c ? 'selected' : '' %>><%= f.etiquetaCategoria(c) %></option>
          <% }); %>
        </select>
      </div>
      <div class="campo md:col-span-2">
        <label for="subcategoria" class="campo-etiqueta">Subcategoría</label>
        <input type="text" id="subcategoria" name="subcategoria" maxlength="80" value="<%= material.subcategoria || '' %>" class="campo-control" aria-describedby="subcategoriaAyuda">
        <p id="subcategoriaAyuda" class="campo-ayuda">Agrupa el material en el selector de la app. Ejemplo: Papel y cartón, Luminarias, Pilas.</p>
      </div>
      <div class="campo md:col-span-3">
        <label for="descripcion" class="campo-etiqueta">Descripción <span class="campo-obligatorio">(obligatorio)</span></label>
        <textarea id="descripcion" name="descripcion" required minlength="10" rows="3" class="campo-control" aria-describedby="descripcionAyuda"><%= material.descripcion || '' %></textarea>
        <p id="descripcionAyuda" class="campo-ayuda">Componentes, estado físico y ejemplos. Mínimo 10 caracteres.</p>
      </div>
      <div class="campo md:col-span-3">
        <label for="guia_manejo" class="campo-etiqueta">Guía de manejo</label>
        <textarea id="guia_manejo" name="guia_manejo" rows="3" class="campo-control" aria-describedby="guiaAyuda"><%= material.guia_manejo || '' %></textarea>
        <p id="guiaAyuda" class="campo-ayuda">Rotulado, tipo de recipiente y condiciones de almacenamiento.</p>
      </div>
      <div class="campo md:col-span-3">
        <label for="advertencia_manejo" class="campo-etiqueta">Advertencia de manejo</label>
        <textarea id="advertencia_manejo" name="advertencia_manejo" rows="2" maxlength="300" class="campo-control" aria-describedby="advertenciaAyuda"><%= material.advertencia_manejo || '' %></textarea>
        <p id="advertenciaAyuda" class="campo-ayuda">Se muestra destacada en la app. Ejemplo: No rompas los tubos: contienen mercurio. Déjala vacía si no aplica.</p>
      </div>
    </div>
    <div class="flex flex-wrap justify-end gap-2">
      <a href="/materiales" class="btn-text">Cancelar</a>
      <button type="submit" class="btn-filled" data-cargando="Guardando…">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">save</span>
        <span data-etiqueta><%= creando ? 'Crear material' : 'Guardar cambios' %></span>
      </button>
    </div>
  </form>

  <% if (!creando && dependencias) { %>
    <section aria-labelledby="tituloEliminarMaterial" class="tarjeta flex flex-col gap-3">
      <h2 id="tituloEliminarMaterial" class="tarjeta-titulo">Eliminar material</h2>
      <% if (dependencias.tieneHistoria) { %>
        <p class="text-body-m text-on-surface-variant">
          No se puede eliminar: hay <%= f.formatoNumero(dependencias.solicitudes) %> solicitud(es) de este material y se perdería su historia y los reportes.
          <a class="enlace" href="/solicitudes?q=<%= encodeURIComponent(material.codigo || '') %>">Ver solicitudes</a>
        </p>
      <% } else { %>
        <p class="text-body-m text-on-surface-variant">
          Ninguna solicitud usa este material.<%= dependencias.gestores > 0 ? ' Se quitará de ' + dependencias.gestores + ' gestor(es) que lo tienen asignado.' : '' %>
        </p>
        <form action="/materiales/eliminar/<%= material.id %>" method="POST"
              data-confirmar-titulo="Eliminar material"
              data-confirmar="Eliminar <%= material.nombre_comun %> del catálogo.<%= dependencias.gestores > 0 ? ' Se quitará de ' + dependencias.gestores + ' gestor(es).' : '' %> Esta acción no se puede deshacer."
              data-confirmar-accion="Eliminar"
              data-confirmar-peligro>
          <button type="submit" class="btn-peligro-outlined">
            <span class="material-symbols-outlined icono-20" aria-hidden="true">delete</span>
            Eliminar material
          </button>
        </form>
      <% } %>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
