<%- include('partials/header', { activeTab: 'materiales' }) %>

<div class="max-w-4xl mx-auto space-y-6">
    <%- include('partials/alert') %>

    <!-- Cabecera de edición y botón para retornar al catálogo -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">
                <a href="/materiales" class="hover:text-brand dark:hover:text-emerald-400 transition flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    <span>Volver a Catálogo RESPEL</span>
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200">Edición</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">Editar Residuo / Material</h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">Modifica la clasificación, especificaciones y guías de manejo</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
                ID: <%= material.id %>
            </span>
        </div>
    </header>

    <!-- Tarjeta de edición de especificaciones técnicas del residuo -->
    <section aria-labelledby="edit-mat-title" class="m3-surface-container p-6 md:p-8">
        <h2 id="edit-mat-title" class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 mb-6 flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-4">
            <span class="material-symbols-outlined text-brand dark:text-emerald-400 text-xl" aria-hidden="true">edit_note</span>
            <span>Modificar Ficha Técnica de Residuo</span>
        </h2>

        <form action="/materiales/edit/<%= material.id %>" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div>
                    <label for="codigo" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Código Oficial *</label>
                    <input type="text" id="codigo" name="codigo" required value="<%= material.codigo %>"
                        placeholder="Ej: Y8, Y9.2, A1160"
                        data-format="uppercase"
                        class="input-ui font-mono uppercase font-bold">
                </div>

                <div>
                    <label for="nombre_comun" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Nombre Descriptivo *</label>
                    <input type="text" id="nombre_comun" name="nombre_comun" required value="<%= material.nombre_comun || material.nombre || '' %>"
                        placeholder="Aceites minerales usados"
                        class="input-ui">
                </div>

                <div>
                    <label for="categoria" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Categoría de Riesgo *</label>
                    <select id="categoria" name="categoria" required class="input-ui font-semibold">
                        <option value="PELIGROSO" <%= (material.categoria || '').includes('PELIGROSO') ? 'selected' : '' %>>PELIGROSO</option>
                        <option value="RIESGO_BIOLOGICO" <%= (material.categoria || '').includes('RIESGO_BIOLOGICO') ? 'selected' : '' %>>RIESGO_BIOLOGICO</option>
                        <option value="RCD" <%= (material.categoria || '').includes('RCD') ? 'selected' : '' %>>RCD</option>
                        <option value="RAEE" <%= (material.categoria || '').includes('RAEE') ? 'selected' : '' %>>RAEE</option>
                        <option value="APROVECHABLE" <%= (material.categoria || '').includes('APROVECHABLE') ? 'selected' : '' %>>APROVECHABLE</option>
                    </select>
                </div>

                <div class="md:col-span-3">
                    <label for="descripcion" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Descripción Técnica del Desecho *</label>
                    <textarea id="descripcion" name="descripcion" required rows="3"
                        placeholder="Especificar componentes, estado físico y ejemplos de desecho..."
                        class="input-ui !h-auto py-2.5"><%= material.descripcion %></textarea>
                </div>

                <div class="md:col-span-3">
                    <label for="guia_manejo" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Guía y Recomendaciones de Acopio</label>
                    <textarea id="guia_manejo" name="guia_manejo" rows="3"
                        placeholder="Rotulado requerido, tipo de contenedor y condiciones de ventilación..."
                        class="input-ui !h-auto py-2.5"><%= material.guia_manejo || '' %></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <a href="/materiales" class="btn-tonal !h-10 !px-5">
                    <span>Cancelar</span>
                </a>
                <button type="submit" class="btn-primary">
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">save</span>
                    <span>Guardar Cambios</span>
                </button>
            </div>
        </form>
    </section>
</div>

<%- include('partials/footer') %>
