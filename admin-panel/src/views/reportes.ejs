<%- include('partials/header', { activeTab: 'reportes', titulo: 'Reportes', recorrido: recorrido }) %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="titulo-pagina">Reciclaje por municipio</h1>
      <p class="mt-1 text-body-l text-on-surface-variant">Cuánto se recicla en cada municipio, para la dirección y las autoridades ambientales.</p>
    </div>
    <a href="<%= enlaceExcel %>" class="no-imprimir btn-filled" download data-recorrido="reportes-descarga">
      <span class="material-symbols-outlined icono-20" aria-hidden="true">download</span>
      Descargar Excel
    </a>
  </div>

  <div class="solo-impresion text-body-s">
    <p>Panel EcoResiduos · Reporte generado el <%= generado %> (hora de Colombia).</p>
    <p>Filtros aplicados: <%= descripcion %>.</p>
  </div>

  <form method="GET" action="/reportes" class="no-imprimir tarjeta grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4" aria-label="Filtrar el reporte" data-validar data-recorrido="reportes-filtros">
    <div class="campo">
      <label for="reporteDesde" class="campo-etiqueta">Confirmadas desde</label>
      <input type="date" id="reporteDesde" name="desde" value="<%= filtros.desde %>" class="campo-control">
    </div>
    <div class="campo">
      <label for="reporteHasta" class="campo-etiqueta">Confirmadas hasta</label>
      <input type="date" id="reporteHasta" name="hasta" value="<%= filtros.hasta %>" class="campo-control">
    </div>
    <div class="campo">
      <label for="reporteCategoria" class="campo-etiqueta">Categoría</label>
      <select id="reporteCategoria" name="categoria" class="campo-control">
        <option value="">Todas las categorías</option>
        <% f.CATEGORIAS_CATALOGO.forEach(function (c) { %>
          <option value="<%= c %>" <%= filtros.categoria === c ? 'selected' : '' %>><%= f.etiquetaCategoria(c) %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex items-end justify-end gap-2">
      <a href="/reportes" class="btn-text">Limpiar</a>
      <button type="submit" class="btn-tonal">Aplicar filtros</button>
    </div>
    <p class="campo-ayuda md:col-span-2 xl:col-span-4">Las fechas son de Colombia (hora de Bogotá) y se filtran por la fecha de confirmación de la recolección.</p>
  </form>

  <% if (errorCarga) { %>
    <%- include('partials/componentes/estado-error', { titulo: 'No pudimos cargar el reporte.', detalle: errorCarga, reintentar: urlActual }) %>
  <% } else if (reporte.total.confirmadas === 0 && reporte.total.sinConfirmar === 0) { %>
    <div class="tarjeta">
      <% if (filtros.desde || filtros.hasta || filtros.categoria) { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'search_off', titulo: 'No hay recolecciones con esos filtros', texto: 'Prueba con otro rango de fechas u otra categoría, o quita los filtros para ver todo.', accion: { href: '/reportes', texto: 'Quitar filtros' } }) %>
      <% } else { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'recycling', titulo: 'Aún no hay recolecciones', texto: 'Cuando los gestores marquen solicitudes como recolectadas, aparecerán aquí por municipio.' }) %>
      <% } %>
    </div>
  <% } else { %>
    <p class="text-body-m text-on-surface-variant"><strong>Filtros:</strong> <%= descripcion %>.</p>

    <%# Primero el resumen, luego el gráfico y al final el detalle: de lo
        general a lo particular. %>
    <section aria-labelledby="tituloCifrasReporte" class="flex flex-col gap-3">
      <h2 id="tituloCifrasReporte" class="sr-only">Cifras principales</h2>
      <dl class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
        <div class="tarjeta-kpi">
          <dt class="text-label-l text-on-surface-variant">Recolecciones confirmadas</dt>
          <dd class="kpi-cifra"><%= f.formatoNumero(cifras.confirmadas) %></dd>
          <dd class="kpi-contexto">En el periodo y la categoría filtrados</dd>
        </div>
        <div class="tarjeta-kpi">
          <dt class="text-label-l text-on-surface-variant">Recolectadas sin confirmar</dt>
          <dd class="kpi-cifra"><%= f.formatoNumero(cifras.sinConfirmar) %></dd>
          <dd class="kpi-contexto">No se cuentan en el total</dd>
        </div>
        <div class="tarjeta-kpi">
          <dt class="text-label-l text-on-surface-variant">Municipio con más recolecciones</dt>
          <% if (cifras.lider) { %>
            <dd class="kpi-cifra kpi-cifra-texto" title="<%= cifras.lider.nombre %>"><%= cifras.lider.nombre %></dd>
            <dd class="kpi-contexto"><%= f.formatoNumero(cifras.lider.valor) %> · <%= cifras.lider.proporcion %> del total</dd>
          <% } else { %>
            <dd class="kpi-cifra">—</dd>
            <dd class="kpi-contexto">Sin recolecciones confirmadas</dd>
          <% } %>
        </div>
        <%# Con una categoría filtrada, «la categoría principal» sería ella misma al 100 %. %>
        <% if (filtros.categoria) { %>
          <div class="tarjeta-kpi">
            <dt class="text-label-l text-on-surface-variant">Municipios con recolecciones</dt>
            <dd class="kpi-cifra"><%= f.formatoNumero(cifras.municipios) %></dd>
            <dd class="kpi-contexto">De los <%= cifras.municipiosTotal %> donde opera EcoResiduos</dd>
          </div>
        <% } else { %>
          <div class="tarjeta-kpi">
            <dt class="text-label-l text-on-surface-variant">Categoría más recolectada</dt>
            <% if (cifras.categoria) { %>
              <dd class="kpi-cifra kpi-cifra-texto" title="<%= cifras.categoria.nombre %>"><%= cifras.categoria.nombre %></dd>
              <dd class="kpi-contexto"><%= f.formatoNumero(cifras.categoria.valor) %> · <%= cifras.categoria.proporcion %> del total</dd>
            <% } else { %>
              <dd class="kpi-cifra">—</dd>
              <dd class="kpi-contexto">Sin recolecciones confirmadas</dd>
            <% } %>
          </div>
        <% } %>
      </dl>
    </section>

    <% if (reporte.total.confirmadas > 0) { %>
      <%# Barras horizontales apiladas: los nombres de municipio se leen
          completos y cada barra suma sus categorías. La tabla de abajo es
          la versión accesible con todas las cifras. %>
      <figure class="tarjeta grafico">
        <figcaption id="tituloGraficoReporte" class="tarjeta-titulo">Recolecciones confirmadas por municipio<%= grafico.series.length > 1 ? ' y categoría' : '' %></figcaption>
        <p id="descGraficoReporte" class="grafico-subtitulo"><%= grafico.resumen %></p>
        <% if (grafico.series.length > 1) { %>
          <p class="grafico-leyenda">
            <% grafico.series.forEach(function (s, i) { %>
              <span class="grafico-leyenda-item">
                <span class="muestra muestra-<%= s.ranura %>" aria-hidden="true"></span>
                <%= s.nombre %>
                <span class="grafico-leyenda-dato"><%= f.formatoNumero(s.total) %> (<%= s.proporcion %>)</span><% if (i < grafico.series.length - 1) { %><span class="sr-only">;</span><% } %>
              </span>
            <% }); %>
          </p>
        <% } %>
        <div class="grafico-lienzo">
          <canvas data-grafico="datosReporte" role="img" aria-labelledby="tituloGraficoReporte" aria-describedby="descGraficoReporte"></canvas>
        </div>
        <p class="grafico-nota">Fuente: solicitudes confirmadas en EcoResiduos. Filtros: <%= descripcion %>. El detalle de cada municipio está en la tabla siguiente.</p>
      </figure>
    <% } %>

    <div class="tabla-contenedor" role="region" aria-labelledby="captionReporte" tabindex="0">
      <table class="tabla tabla-primera-fija" data-sin-apilar>
        <caption id="captionReporte">Número de recolecciones confirmadas por municipio y categoría</caption>
        <thead>
          <tr>
            <th scope="col">Municipio</th>
            <% reporte.categorias.forEach(function (c) { %>
              <th scope="col" class="num"><%= c.etiqueta %></th>
            <% }); %>
            <th scope="col" class="num">Total confirmadas</th>
            <th scope="col" class="num">% del total</th>
            <th scope="col" class="num">Recolectadas sin confirmar</th>
          </tr>
        </thead>
        <tbody>
          <% reporte.filas.forEach(function (fila) { %>
            <tr>
              <th scope="row"><%= fila.municipio %></th>
              <% reporte.categorias.forEach(function (c) { %>
                <td class="num <%= fila.porCategoria[c.clave] === 0 ? 'cifra-cero' : '' %>"><%= f.formatoNumero(fila.porCategoria[c.clave]) %></td>
              <% }); %>
              <td class="num font-semibold <%= fila.confirmadas === 0 ? 'cifra-cero' : '' %>"><%= f.formatoNumero(fila.confirmadas) %></td>
              <td class="num">
                <span class="celda-proporcion">
                  <span class="barra-dato" aria-hidden="true"><span data-proporcion="<%= reporte.total.confirmadas > 0 ? fila.confirmadas / reporte.total.confirmadas : 0 %>"></span></span>
                  <span class="valor <%= fila.confirmadas === 0 ? 'cifra-cero' : '' %>"><%= f.formatoPorcentaje(fila.confirmadas, reporte.total.confirmadas) %></span>
                </span>
              </td>
              <td class="num <%= fila.sinConfirmar === 0 ? 'cifra-cero' : '' %>"><%= f.formatoNumero(fila.sinConfirmar) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Total</th>
            <% reporte.categorias.forEach(function (c) { %>
              <td class="num"><%= f.formatoNumero(reporte.total.porCategoria[c.clave]) %></td>
            <% }); %>
            <td class="num"><%= f.formatoNumero(reporte.total.confirmadas) %></td>
            <td class="num"><%= reporte.total.confirmadas > 0 ? '100 %' : '0 %' %></td>
            <td class="num"><%= f.formatoNumero(reporte.total.sinConfirmar) %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="nota nota-info">
      <span class="material-symbols-outlined" aria-hidden="true">info</span>
      <div class="flex flex-col gap-1 text-body-m">
        <p>Se cuentan las recolecciones confirmadas por el generador o confirmadas solas a las 72 horas. Las que tienen un problema reportado sin confirmar no se cuentan.</p>
        <p>«Recolectadas sin confirmar» muestra las que el gestor marcó como recolectadas y aún no se confirman: si la confirmación automática (pg_cron) no está activa, aquí se acumulan.</p>
        <% if (reporte.hayOtro) { %><p>«Otro / sin dato» agrupa las solicitudes cuyo municipio no es uno de los 6 donde opera EcoResiduos.</p><% } %>
      </div>
    </div>

    <section aria-labelledby="tituloUnidades" class="flex flex-col gap-3">
      <h2 id="tituloUnidades" class="seccion-titulo">Cantidades declaradas por unidad</h2>
      <% if (reporte.unidades.length === 0) { %>
        <p class="text-body-m text-on-surface-variant">No hay recolecciones confirmadas con estos filtros.</p>
      <% } else { %>
        <p class="text-body-m text-on-surface-variant">Cada columna suma solo las cantidades declaradas en esa unidad: no se convierten ni se mezclan unidades.</p>
        <div class="tabla-contenedor" role="region" aria-labelledby="captionUnidades" tabindex="0">
          <table class="tabla tabla-primera-fija" data-sin-apilar>
            <caption id="captionUnidades">Cantidades estimadas por los generadores, en la unidad que cada uno declaró</caption>
            <thead>
              <tr>
                <th scope="col">Municipio</th>
                <% reporte.unidades.forEach(function (u) { %>
                  <th scope="col" class="num"><%= u.etiqueta %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% reporte.filas.forEach(function (fila) { %>
                <tr>
                  <th scope="row"><%= fila.municipio %></th>
                  <% reporte.unidades.forEach(function (u) { %>
                    <td class="num <%= fila.porUnidad[u.clave] === 0 ? 'cifra-cero' : '' %>"><%= f.formatoNumero(fila.porUnidad[u.clave]) %></td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Total</th>
                <% reporte.unidades.forEach(function (u) { %>
                  <td class="num"><%= f.formatoNumero(reporte.total.porUnidad[u.clave]) %></td>
                <% }); %>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>
    </section>

    <% if (reporte.total.confirmadas > 0) { %>
      <script type="application/json" id="datosReporte"><%- jsonParaScript(grafico.datos) %></script>
      <script src="<%= recurso('/vendor/chart.umd.js') %>"></script>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
