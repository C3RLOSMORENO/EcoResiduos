<%
  const creando = modo === 'crear';
  const tituloPagina = creando ? 'Nueva autoridad ambiental' : 'Editar ' + (autoridad.sigla || autoridad.nombre || 'autoridad');
  const accion = creando ? '/autoridades/guardar' : '/autoridades/edit/' + autoridad.id;
%>
<%- include('partials/header', { activeTab: 'autoridades', titulo: tituloPagina }) %>

<div class="flex flex-col gap-6">
  <nav aria-label="Ruta de navegación" class="text-body-m">
    <ol class="flex flex-wrap items-center gap-1" role="list">
      <li><a class="enlace" href="/autoridades">Autoridades</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-on-surface-variant"><%= creando ? 'Nueva' : (autoridad.sigla || autoridad.nombre) %></li>
    </ol>
  </nav>

  <div>
    <h1 class="titulo-pagina"><%= tituloPagina %></h1>
    <p class="mt-1 text-body-l text-on-surface-variant">Datos de contacto que la app muestra en el directorio de autoridades.</p>
  </div>

  <form action="<%= accion %>" method="POST" class="tarjeta flex flex-col gap-4" data-validar data-conservar>
    <p class="campo-ayuda">Los campos marcados con «obligatorio» se deben llenar.</p>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="campo md:col-span-2">
        <label for="nombre" class="campo-etiqueta">Nombre oficial <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="text" id="nombre" name="nombre" required minlength="3" maxlength="150" value="<%= autoridad.nombre || '' %>" autocomplete="organization" class="campo-control">
      </div>
      <div class="campo">
        <label for="sigla" class="campo-etiqueta">Sigla <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="text" id="sigla" name="sigla" required maxlength="20" value="<%= autoridad.sigla || '' %>" data-format="uppercase" class="campo-control">
      </div>
      <div class="campo md:col-span-3">
        <label for="jurisdiccion" class="campo-etiqueta">Jurisdicción <span class="campo-obligatorio">(obligatorio)</span></label>
        <textarea id="jurisdiccion" name="jurisdiccion" required rows="2" class="campo-control" aria-describedby="jurisdiccionAyuda"><%= autoridad.jurisdiccion || '' %></textarea>
        <p id="jurisdiccionAyuda" class="campo-ayuda">Ejemplo: 74 municipios del departamento de Santander.</p>
      </div>
      <div class="campo">
        <label for="telefono" class="campo-etiqueta">Teléfono <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="tel" id="telefono" name="telefono" required maxlength="50" value="<%= autoridad.telefono || '' %>" data-format="phone" autocomplete="tel" class="campo-control">
      </div>
      <div class="campo">
        <label for="email" class="campo-etiqueta">Correo o PQRS <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="email" id="email" name="email" required maxlength="100" value="<%= autoridad.email || '' %>" autocomplete="email" class="campo-control">
      </div>
      <div class="campo">
        <label for="sitio_web" class="campo-etiqueta">Sitio web <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="text" inputmode="url" id="sitio_web" name="sitio_web" required maxlength="255" value="<%= autoridad.sitio_web || '' %>" autocomplete="url" class="campo-control" aria-describedby="sitioAyuda">
        <p id="sitioAyuda" class="campo-ayuda">Con https://. Ejemplo: https://www.cas.gov.co</p>
      </div>
      <div class="campo md:col-span-2">
        <label for="direccion" class="campo-etiqueta">Dirección de la sede <span class="campo-obligatorio">(obligatorio)</span></label>
        <input type="text" id="direccion" name="direccion" required maxlength="255" value="<%= autoridad.direccion || '' %>" autocomplete="street-address" class="campo-control">
      </div>
      <div class="campo">
        <label for="horario" class="campo-etiqueta">Horario de atención</label>
        <input type="text" id="horario" name="horario" maxlength="120" value="<%= autoridad.horario || '' %>" class="campo-control" aria-describedby="horarioAutoridadAyuda">
        <p id="horarioAutoridadAyuda" class="campo-ayuda">Ejemplo: lun a vie 8:00 a 12:00 y 14:00 a 18:00.</p>
      </div>
    </div>
    <div class="flex flex-wrap justify-end gap-2">
      <a href="/autoridades" class="btn-text">Cancelar</a>
      <button type="submit" class="btn-filled" data-cargando="Guardando…">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">save</span>
        <span data-etiqueta><%= creando ? 'Crear autoridad' : 'Guardar cambios' %></span>
      </button>
    </div>
  </form>

  <% if (!creando) { %>
    <section aria-labelledby="tituloEliminarAutoridad" class="tarjeta flex flex-col gap-3">
      <h2 id="tituloEliminarAutoridad" class="tarjeta-titulo">Eliminar autoridad</h2>
      <p class="text-body-m text-on-surface-variant">Deja de aparecer en el directorio de la app.</p>
      <form action="/autoridades/eliminar/<%= autoridad.id %>" method="POST"
            data-confirmar-titulo="Eliminar autoridad"
            data-confirmar="Eliminar <%= autoridad.nombre %> del directorio. Dejará de aparecer en la app. Esta acción no se puede deshacer."
            data-confirmar-accion="Eliminar"
            data-confirmar-peligro>
        <button type="submit" class="btn-peligro-outlined">
          <span class="material-symbols-outlined icono-20" aria-hidden="true">delete</span>
          Eliminar autoridad
        </button>
      </form>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
