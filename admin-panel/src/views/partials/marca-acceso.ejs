<%
  // Etiquetas de residuo con ojal, la firma visual de la app (EtiquetaBorder en
  // app/lib/theme/etiqueta_border.dart), con los colores reales de cada categoría.
  const etiquetas = [
    { cat: 'aprovechable', texto: 'Aprovechable', x: 40, y: 20, giro: -6 },
    { cat: 'peligroso', texto: 'Peligroso (RESPEL)', x: 236, y: 64, giro: 5 },
    { cat: 'raee', texto: 'RAEE', x: 24, y: 120, giro: 3 },
    { cat: 'rcd', texto: 'Escombros (RCD)', x: 232, y: 168, giro: -4 },
    { cat: 'riesgo-biologico', texto: 'Riesgo biológico', x: 52, y: 222, giro: 6 }
  ];
%>
<%# Computador: panel de marca a la izquierda. %>
<aside class="relative hidden overflow-hidden bg-primary text-on-primary lg:flex lg:flex-col lg:justify-between lg:p-12" aria-label="EcoResiduos">
  <div class="flex flex-col gap-6">
    <span class="flex h-24 w-24 items-center justify-center rounded-xl bg-[#FFFFFF] shadow-lg">
      <img src="/images/isotipo-192.png" alt="" width="72" height="72" class="h-[72px] w-[72px]">
    </span>
    <div class="flex flex-col gap-2">
      <p class="font-display text-display-m">EcoResiduos</p>
      <p class="text-title-l font-semibold">Panel de administración</p>
      <p class="max-w-sm text-body-l opacity-90">Gestores, solicitudes y reciclaje de Santander en un solo lugar.</p>
    </div>
  </div>

  <svg viewBox="0 0 540 300" class="mt-10 w-full max-w-lg" aria-hidden="true" focusable="false">
    <defs>
      <%# Rectángulo redondeado con el ojal vaciado (evenodd). %>
      <path id="formaEtiqueta" fill-rule="evenodd"
            d="M12 0H248A12 12 0 0 1 260 12V52A12 12 0 0 1 248 64H12A12 12 0 0 1 0 52V12A12 12 0 0 1 12 0Z
               M24 32m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0Z"/>
    </defs>
    <% etiquetas.forEach(function (e) { %>
      <g transform="translate(<%= e.x %> <%= e.y %>) rotate(<%= e.giro %> 130 32)">
        <use href="#formaEtiqueta" class="etiqueta-fondo-<%= e.cat %>"/>
        <text x="44" y="40" font-family="Public Sans, sans-serif" font-size="20" font-weight="600"
              class="etiqueta-texto-<%= e.cat %>"><%= e.texto %></text>
      </g>
    <% }); %>
  </svg>
</aside>
