<!-- M3 Notification Toast / Snackbar Flotante Superior Central -->
<% 
  const textoMensaje = (typeof feedback !== 'undefined' && feedback && feedback.message) || 
                       (typeof mensajeExito !== 'undefined' && mensajeExito) || 
                       (typeof mensajeError !== 'undefined' && mensajeError) || 
                       (typeof mensaje !== 'undefined' && mensaje);
  const esError = (typeof feedback !== 'undefined' && feedback && feedback.type === 'error') || 
                  (typeof mensajeError !== 'undefined' && mensajeError);
%>

<div id="m3SnackbarContainer" class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none max-w-sm sm:max-w-md w-full px-4">
  <% if (textoMensaje) { %>
    <div id="m3Snackbar" 
         role="status" 
         aria-live="polite"
         class="pointer-events-auto w-full flex items-center gap-3 rounded-2xl bg-white dark:bg-[#1E293B] border border-slate-200/90 dark:border-slate-700/80 px-4 py-3.5 text-slate-800 dark:text-slate-100 shadow-xl shadow-slate-900/10 dark:shadow-black/30 transition-all duration-300 transform -translate-y-4 opacity-0">
      
      <!-- Leading Icon -->
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl <%= esError ? 'bg-rose-50 text-rose-600 dark:bg-rose-950/40 dark:text-rose-400' : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400' %>">
        <% if (esError) { %>
          <span class="material-symbols-outlined text-lg" aria-hidden="true">error</span>
        <% } else { %>
          <span class="material-symbols-outlined text-lg" aria-hidden="true">check_circle</span>
        <% } %>
      </div>

      <!-- Texto del mensaje -->
      <p class="text-xs font-medium leading-snug flex-1">
        <%= textoMensaje %>
      </p>

      <!-- Botón de Cerrar -->
      <button type="button" 
              onclick="cerrarSnackbar(this.closest('#m3Snackbar'))" 
              aria-label="Cerrar notificación" 
              class="inline-flex h-6 w-6 items-center justify-center rounded-full text-slate-400 hover:text-slate-700 dark:text-slate-500 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
        <span class="material-symbols-outlined text-base" aria-hidden="true">close</span>
      </button>
    </div>
  <% } %>
</div>

<script>
  window.mostrarNotificacion = function(mensaje, esError = false) {
    let container = document.getElementById('m3SnackbarContainer');
    if (!container) {
      container = document.createElement('div');
      container.id = 'm3SnackbarContainer';
      container.className = 'fixed top-6 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none max-w-sm sm:max-w-md w-full px-4';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    toast.className = 'pointer-events-auto w-full flex items-center gap-3 rounded-2xl bg-white dark:bg-[#1E293B] border border-slate-200/90 dark:border-slate-700/80 px-4 py-3.5 text-slate-800 dark:text-slate-100 shadow-xl shadow-slate-900/10 dark:shadow-black/30 transition-all duration-300 transform -translate-y-4 opacity-0';
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');

    const iconColor = esError ? 'bg-rose-50 text-rose-600 dark:bg-rose-950/40 dark:text-rose-400' : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400';
    const iconName = esError ? 'error' : 'check_circle';

    toast.innerHTML = `
      <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl ${iconColor}">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">${iconName}</span>
      </div>
      <p class="text-xs font-medium leading-snug flex-1">${mensaje}</p>
      <button type="button" aria-label="Cerrar notificación" class="inline-flex h-6 w-6 items-center justify-center rounded-full text-slate-400 hover:text-slate-700 dark:text-slate-500 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
        <span class="material-symbols-outlined text-base" aria-hidden="true">close</span>
      </button>
    `;

    toast.querySelector('button').addEventListener('click', () => window.cerrarSnackbar(toast));

    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.classList.remove('-translate-y-4', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
    });

    setTimeout(() => {
      window.cerrarSnackbar(toast);
    }, 4000);
  };

  window.cerrarSnackbar = function(el) {
    const snackbar = el || document.getElementById('m3Snackbar');
    if (snackbar) {
      snackbar.classList.remove('translate-y-0', 'opacity-100');
      snackbar.classList.add('-translate-y-4', 'opacity-0');
      setTimeout(() => snackbar.remove(), 300);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    const initialSnackbar = document.getElementById('m3Snackbar');
    if (initialSnackbar) {
      requestAnimationFrame(() => {
        initialSnackbar.classList.remove('-translate-y-4', 'opacity-0');
        initialSnackbar.classList.add('translate-y-0', 'opacity-100');
      });

      setTimeout(() => {
        window.cerrarSnackbar(initialSnackbar);
      }, 4000);
    }
  });
</script>

