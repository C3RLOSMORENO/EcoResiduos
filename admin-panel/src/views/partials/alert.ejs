<%
  // Acepta los avisos de ?msg=&type=, ?success= y ?error= (middleware de
  // avisos) y los que pasa el controlador como feedback o message/type.
  let avisoMostrar = null;
  if (typeof feedback !== 'undefined' && feedback && feedback.message) {
    avisoMostrar = { tipo: feedback.type === 'error' ? 'error' : 'exito', mensaje: feedback.message };
  } else if (typeof message !== 'undefined' && message) {
    avisoMostrar = { tipo: (typeof type !== 'undefined' && type === 'error') ? 'error' : 'exito', mensaje: message };
  } else if (typeof aviso !== 'undefined' && aviso) {
    avisoMostrar = aviso;
  }
%>
<div id="avisosEstado" class="avisos-region" role="status" aria-live="polite" aria-atomic="true">
  <% if (avisoMostrar && avisoMostrar.tipo !== 'error') { %>
    <div class="aviso" data-aviso>
      <span class="material-symbols-outlined icono-20" aria-hidden="true">check_circle</span>
      <p class="flex-1"><%= avisoMostrar.mensaje %></p>
      <button type="button" class="btn-icono" data-cerrar-aviso aria-label="Cerrar aviso">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">close</span>
      </button>
    </div>
  <% } %>
</div>
<div id="avisosAlerta" role="alert" aria-live="assertive" aria-atomic="true">
  <% if (avisoMostrar && avisoMostrar.tipo === 'error') { %>
    <div class="nota nota-error mb-4" data-aviso-error>
      <span class="material-symbols-outlined" aria-hidden="true">error</span>
      <p class="flex-1"><%= avisoMostrar.mensaje %></p>
    </div>
  <% } %>
</div>
