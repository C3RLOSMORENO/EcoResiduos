<%
  const pestana = typeof activeTab !== 'undefined' ? activeTab : '';
  const enlacesNav = [
    { clave: 'dashboard', href: '/dashboard', icono: 'home', texto: 'Inicio' },
    { clave: 'solicitudes', href: '/solicitudes', icono: 'local_shipping', texto: 'Solicitudes' },
    { clave: 'gestores', href: '/gestores', icono: 'domain', texto: 'Gestores' },
    { clave: 'reportes', href: '/reportes', icono: 'monitoring', texto: 'Reportes' },
    { clave: 'generadores', href: '/ciudadanos', icono: 'groups', texto: 'Ciudadanos' },
    { clave: 'materiales', href: '/materiales', icono: 'category', texto: 'Materiales' },
    { clave: 'autoridades', href: '/autoridades', icono: 'account_balance', texto: 'Autoridades' }
  ];
%><!DOCTYPE html>
<html lang="es-CO">
<head>
  <%- include('head', { titulo: typeof titulo !== 'undefined' ? titulo : '' }) %>
</head>
<body data-sesion-ms="<%= typeof sesionMs !== 'undefined' ? sesionMs : 900000 %>">
  <a href="#contenido" class="saltar">Saltar al contenido</a>

  <div id="navFondo" class="nav-fondo" hidden></div>

  <nav id="navPrincipal" class="app-nav" aria-label="Navegación principal">
    <a href="/dashboard" class="mb-4 flex items-center gap-3 rounded-sm px-3 py-2 no-underline" aria-label="EcoResiduos, Panel de administración: ir al inicio">
      <img src="<%= recurso('/images/isotipo-192.png') %>" alt="" width="40" height="40" class="h-10 w-10 object-contain">
      <span class="nav-marca-texto">
        <span class="block font-display text-title-l text-on-surface">EcoResiduos</span>
        <span class="block text-label-m text-on-surface-variant">Panel de administración</span>
      </span>
    </a>
    <ul class="flex flex-col gap-1" role="list">
      <% enlacesNav.forEach(function (item) { %>
        <li>
          <a href="<%= item.href %>" class="nav-item" <%- pestana === item.clave ? 'aria-current="page"' : '' %>>
            <span class="material-symbols-outlined" aria-hidden="true"><%= item.icono %></span>
            <span class="nav-etiqueta"><%= item.texto %></span>
          </a>
        </li>
      <% }); %>
    </ul>
  </nav>

  <div id="appContenido" class="app-contenido">
    <header class="barra-superior">
      <button type="button" id="botonMenu" class="btn-icono boton-menu md:hidden" aria-expanded="false" aria-controls="navPrincipal" aria-label="Abrir menú de navegación">
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
      <a href="/dashboard" class="flex items-center gap-2 font-display text-title-l text-on-surface no-underline md:hidden">EcoResiduos</a>
      <div class="ml-auto flex items-center gap-1">
        <button type="button" id="botonTema" class="btn-icono" aria-pressed="false" aria-label="Modo oscuro">
          <span class="material-symbols-outlined" aria-hidden="true" data-icono-tema>dark_mode</span>
        </button>
        <form action="/logout" method="POST" class="m-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-text">
            <span class="material-symbols-outlined icono-20" aria-hidden="true">logout</span>
            <span class="sr-only md:not-sr-only">Cerrar sesión</span>
          </button>
        </form>
      </div>
    </header>

    <main id="contenido" class="app-main" tabindex="-1">
      <%- include('alert') %>
