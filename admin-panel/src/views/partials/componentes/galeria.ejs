<% const tituloModo = p === 'claro' ? 'tituloClaro' : 'tituloOscuro'; %>
<%# Muestra de todos los componentes. p es el prefijo de los id para poder incluirla dos veces. %>
<div class="flex flex-col gap-6">
  <section aria-labelledby="<%= p %>Botones <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Botones" class="text-title-l">Botones</h3>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="btn-filled">Filled (acción principal)</button>
      <button type="button" class="btn-tonal">Tonal</button>
      <button type="button" class="btn-outlined">Outlined</button>
      <button type="button" class="btn-text">Text</button>
      <button type="button" class="btn-peligro">Peligro</button>
      <button type="button" class="btn-peligro-outlined">Peligro outlined</button>
      <button type="button" class="btn-filled" disabled>Deshabilitado</button>
      <button type="button" class="btn-icono" aria-label="Editar material de ejemplo"><span class="material-symbols-outlined" aria-hidden="true">edit</span></button>
    </div>
  </section>

  <section aria-labelledby="<%= p %>Campos <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Campos" class="text-title-l">Campos</h3>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="campo">
        <label for="<%= p %>Campo1" class="campo-etiqueta">Razón social <span class="campo-obligatorio">(obligatorio)</span></label>
        <input id="<%= p %>Campo1" class="campo-control" value="RECICLAJES DEL ORIENTE S.A.S." aria-describedby="<%= p %>Campo1Ayuda">
        <p id="<%= p %>Campo1Ayuda" class="campo-ayuda">Texto de ayuda.</p>
      </div>
      <div class="campo">
        <label for="<%= p %>Campo2" class="campo-etiqueta">Correo <span class="campo-obligatorio">(obligatorio)</span></label>
        <input id="<%= p %>Campo2" class="campo-control" value="correo-invalido" aria-invalid="true" aria-describedby="<%= p %>Campo2Error">
        <p id="<%= p %>Campo2Error" class="campo-error"><span class="material-symbols-outlined icono-18" aria-hidden="true">error</span><span>Escribe un correo válido.</span></p>
      </div>
      <div class="campo">
        <label for="<%= p %>Campo3" class="campo-etiqueta">Municipio</label>
        <select id="<%= p %>Campo3" class="campo-control"><% MUNICIPIOS.forEach(function (m) { %><option><%= m %></option><% }); %></select>
      </div>
    </div>
    <label class="casilla"><input type="checkbox" checked> Casilla de verificación</label>
  </section>

  <section aria-labelledby="<%= p %>Chips <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Chips" class="text-title-l">Chips de categoría y estado</h3>
    <div class="flex flex-wrap gap-2">
      <% Object.keys(f.CATEGORIAS).forEach(function (c) { %><%- include('chip-categoria', { categoria: c }) %><% }); %>
    </div>
    <div class="flex flex-wrap gap-2">
      <% Object.keys(f.ESTADOS).filter(function (e) { return e !== 'ASIGNADA_OTRO'; }).forEach(function (e) { %><%- include('chip-estado', { estado: e, tipo: 'solicitud' }) %><% }); %>
    </div>
    <div class="flex flex-wrap gap-2">
      <% Object.keys(f.ESTADOS_VERIFICACION).forEach(function (e) { %><%- include('chip-estado', { estado: e, tipo: 'verificacion' }) %><% }); %>
    </div>
  </section>

  <section aria-labelledby="<%= p %>Tarjetas <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Tarjetas" class="text-title-l">Tarjetas y KPI</h3>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
      <div class="tarjeta"><p class="tarjeta-titulo">Tarjeta</p><p class="text-body-m text-on-surface-variant">Contenido sobre surface-container-lowest.</p></div>
      <dl class="tarjeta-kpi"><dt class="text-label-l text-on-surface-variant">Solicitudes</dt><dd class="kpi-cifra">1.250</dd></dl>
      <a href="#<%= p %>Tarjetas" class="tarjeta-accion tarjeta-accion-activa"><span class="material-symbols-outlined" aria-hidden="true">report</span><span class="flex flex-col"><span class="kpi-cifra text-inherit">3</span><span class="text-title-s">Problemas reportados</span></span></a>
    </div>
  </section>

  <section aria-labelledby="<%= p %>Notas <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Notas" class="text-title-l">Avisos</h3>
    <div class="nota nota-info"><span class="material-symbols-outlined" aria-hidden="true">info</span><p>Información.</p></div>
    <div class="nota nota-advertencia"><span class="material-symbols-outlined" aria-hidden="true">warning</span><p>Advertencia.</p></div>
    <div class="nota nota-exito"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span><p>Éxito.</p></div>
    <div class="nota nota-error"><span class="material-symbols-outlined" aria-hidden="true">error</span><p>Error.</p></div>
    <div class="aviso"><span class="material-symbols-outlined icono-20" aria-hidden="true">check_circle</span><p class="flex-1">Snackbar: Gestor aprobado.</p></div>
  </section>

  <section aria-labelledby="<%= p %>Tabla <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Tabla" class="text-title-l">Tabla</h3>
    <div class="tabla-contenedor" role="region" aria-labelledby="<%= p %>TablaCaption <%= tituloModo %>" tabindex="0">
      <table class="tabla">
        <caption id="<%= p %>TablaCaption">Ejemplo de tabla con encabezados de fila y columna</caption>
        <thead><tr><th scope="col" aria-sort="ascending">Municipio</th><th scope="col" class="num">Recolecciones</th><th scope="col" class="num">Total (kg)</th></tr></thead>
        <tbody>
          <tr><th scope="row">Bucaramanga</th><td class="num">12</td><td class="num">1.250</td></tr>
          <tr><th scope="row">Floridablanca</th><td class="num">4</td><td class="num">320,5</td></tr>
        </tbody>
        <tfoot><tr><th scope="row">Total</th><td class="num">16</td><td class="num">1.570,5</td></tr></tfoot>
      </table>
    </div>
  </section>

  <section aria-labelledby="<%= p %>Estados <%= tituloModo %>" class="flex flex-col gap-3">
    <h3 id="<%= p %>Estados" class="text-title-l">Estados vacío y de error</h3>
    <div class="tarjeta"><%- include('estado-vacio', { icono: 'task_alt', titulo: 'Aún no hay gestores por revisar', texto: 'Cuando una empresa se registre desde la app, aparecerá aquí.' }) %></div>
    <%- include('estado-error', { titulo: 'No pudimos cargar las solicitudes.', reintentar: '/componentes' }) %>
  </section>
</div>
