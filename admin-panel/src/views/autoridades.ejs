<%- include('partials/header', { activeTab: 'autoridades', titulo: 'Autoridades ambientales' }) %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="titulo-pagina">Autoridades ambientales</h1>
      <p class="mt-1 text-body-l text-on-surface-variant">Directorio de entidades de control que la app muestra a generadores y gestores.</p>
    </div>
    <a href="/autoridades/nuevo" class="btn-filled">
      <span class="material-symbols-outlined icono-20" aria-hidden="true">add</span>
      Nueva autoridad
    </a>
  </div>

  <form method="GET" action="/autoridades" class="panel-filtros flex flex-wrap items-end gap-4" role="search" aria-label="Buscar autoridades">
    <div class="campo min-w-0 flex-1">
      <label for="filtroAutoridad" class="campo-etiqueta">Buscar</label>
      <input type="search" id="filtroAutoridad" name="q" value="<%= filtros.q %>" class="campo-control" aria-describedby="filtroAutoridadAyuda">
      <p id="filtroAutoridadAyuda" class="campo-ayuda">Nombre, sigla o jurisdicción.</p>
    </div>
    <div class="flex gap-2 pb-6">
      <a href="/autoridades" class="btn-text">Limpiar</a>
      <button type="submit" class="btn-tonal">Buscar</button>
    </div>
  </form>

  <% if (errorCarga) { %>
    <%- include('partials/componentes/estado-error', { titulo: 'No pudimos cargar las autoridades.', detalle: errorCarga, reintentar: urlActual }) %>
  <% } else if (autoridades.length === 0) { %>
    <div class="tarjeta">
      <% if (filtros.q) { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'search_off', titulo: 'No encontramos autoridades con esa búsqueda', accion: { href: '/autoridades', texto: 'Limpiar búsqueda' } }) %>
      <% } else { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'account_balance', titulo: 'Aún no hay autoridades en el directorio', accion: { href: '/autoridades/nuevo', texto: 'Nueva autoridad' } }) %>
      <% } %>
    </div>
  <% } else { %>
    <div>
      <div class="tabla-contenedor" role="region" aria-labelledby="captionAutoridades" tabindex="0">
        <table class="tabla">
          <caption id="captionAutoridades">Autoridades ambientales, por nombre</caption>
          <thead>
            <tr>
              <th scope="col">Entidad</th>
              <th scope="col">Jurisdicción</th>
              <th scope="col">Contacto</th>
              <th scope="col">Horario</th>
              <th scope="col"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody>
            <% autoridades.forEach(function (a) { const web = f.urlSegura(a.sitio_web); %>
              <tr>
                <th scope="row">
                  <span class="block font-semibold"><%= a.sigla || 'Sin sigla' %></span>
                  <span class="block text-body-s font-normal text-on-surface-variant"><%= a.nombre %></span>
                </th>
                <td><%= f.textoODato(a.jurisdiccion) %></td>
                <td>
                  <div class="flex flex-col gap-1 text-body-s">
                    <% if (web) { %>
                      <a class="enlace inline-flex items-center gap-1.5 break-all" href="<%= web %>" target="_blank" rel="noopener noreferrer">
                        <span class="material-symbols-outlined icono-16 text-primary" aria-hidden="true">open_in_new</span>
                        <span><%= web.replace(/^https?:\/\//, '').replace(/\/$/, '') %></span>
                        <span class="sr-only"> (se abre en una pestaña nueva)</span>
                      </a>
                    <% } %>
                    <% if (a.telefono) { %>
                      <span class="inline-flex items-center gap-1.5 text-on-surface">
                        <span class="material-symbols-outlined icono-16 text-on-surface-variant" aria-hidden="true">smartphone</span>
                        <span><%= a.telefono %></span>
                      </span>
                    <% } %>
                    <% if (a.email) { %>
                      <span class="inline-flex items-center gap-1.5 break-all text-on-surface-variant">
                        <span class="material-symbols-outlined icono-16 text-on-surface-variant" aria-hidden="true">mail</span>
                        <span><%= a.email %></span>
                      </span>
                    <% } %>
                    <% if (!web && !a.telefono && !a.email) { %>
                      <span class="text-on-surface-variant">Sin dato</span>
                    <% } %>
                  </div>
                </td>
                <td><%= f.textoODato(a.horario) %></td>
                <td class="text-right">
                  <a href="/autoridades/edit/<%= a.id %>" class="btn-outlined btn-sm" aria-label="Editar <%= a.sigla || a.nombre %>">Editar</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('partials/componentes/paginacion', { pag, nombre: 'autoridades' }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
