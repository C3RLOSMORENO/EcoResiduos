<%- include('partials/header', { activeTab: 'materiales', titulo: 'Materiales', recorrido: recorrido }) %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="titulo-pagina">Materiales</h1>
      <p class="mt-1 text-body-l text-on-surface-variant">Catálogo de residuos que los generadores pueden publicar y los gestores recibir.</p>
    </div>
    <a href="/materiales/nuevo" class="btn-filled" data-recorrido="materiales-nuevo">
      <span class="material-symbols-outlined icono-20" aria-hidden="true">add</span>
      Nuevo material
    </a>
  </div>

  <form method="GET" action="/materiales" class="panel-filtros grid grid-cols-1 gap-4 md:grid-cols-3" role="search" aria-label="Filtrar materiales">
    <div class="campo md:col-span-2">
      <label for="filtroMaterial" class="campo-etiqueta">Buscar</label>
      <input type="search" id="filtroMaterial" name="q" value="<%= filtros.q %>" class="campo-control" aria-describedby="filtroMaterialAyuda">
      <p id="filtroMaterialAyuda" class="campo-ayuda">Código, nombre, subcategoría o descripción.</p>
    </div>
    <div class="campo">
      <label for="filtroCategoriaMaterial" class="campo-etiqueta">Categoría</label>
      <select id="filtroCategoriaMaterial" name="categoria" class="campo-control">
        <option value="">Todas las categorías</option>
        <% f.CATEGORIAS_CATALOGO.forEach(function (c) { %>
          <option value="<%= c %>" <%= filtros.categoria === c ? 'selected' : '' %>><%= f.etiquetaCategoria(c) %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex flex-wrap items-center justify-end gap-2 md:col-span-3">
      <a href="/materiales" class="btn-text">Limpiar filtros</a>
      <button type="submit" class="btn-tonal">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">filter_list</span>
        Filtrar
      </button>
    </div>
  </form>

  <% if (errorCarga) { %>
    <%- include('partials/componentes/estado-error', { titulo: 'No pudimos cargar los materiales.', detalle: errorCarga, reintentar: urlActual }) %>
  <% } else if (materiales.length === 0) { %>
    <div class="tarjeta">
      <% if (filtros.q || filtros.categoria) { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'search_off', titulo: 'No encontramos materiales con esos filtros', accion: { href: '/materiales', texto: 'Limpiar filtros' } }) %>
      <% } else { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'category', titulo: 'Aún no hay materiales en el catálogo', texto: 'Crea el primero para que los generadores puedan publicarlo.', accion: { href: '/materiales/nuevo', texto: 'Nuevo material' } }) %>
      <% } %>
    </div>
  <% } else { %>
    <div data-recorrido="materiales-tabla">
      <div class="tabla-contenedor" role="region" aria-labelledby="captionMateriales" tabindex="0">
        <table class="tabla">
          <caption id="captionMateriales">Catálogo de materiales<%= filtros.categoria ? ' · ' + f.etiquetaCategoria(filtros.categoria) : '' %></caption>
          <thead>
            <tr>
              <%- include('partials/componentes/encabezado-orden', { campo: 'codigo', texto: 'Código', ordenActual: filtros.orden, ruta: '/materiales' }) %>
              <%- include('partials/componentes/encabezado-orden', { campo: 'nombre', texto: 'Nombre común', ordenActual: filtros.orden, ruta: '/materiales' }) %>
              <th scope="col">Categoría</th>
              <th scope="col"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody>
            <% materiales.forEach(function (m) { %>
              <tr>
                <td class="whitespace-nowrap font-semibold"><%= m.codigo %></td>
                <th scope="row">
                  <%= m.nombre_comun %>
                  <% if (m.descripcion) { %><span class="block max-w-prose text-body-s font-normal text-on-surface-variant"><%= m.descripcion.length > 140 ? m.descripcion.slice(0, 140) + '…' : m.descripcion %></span><% } %>
                </th>
                <td>
                  <%- include('partials/componentes/chip-categoria', { categoria: m.categoria }) %>
                  <% if (m.subcategoria) { %><span class="block text-body-s text-on-surface-variant"><%= m.subcategoria %></span><% } %>
                </td>
                <td class="text-right">
                  <a href="/materiales/edit/<%= m.id %>" class="btn-outlined btn-sm" aria-label="Editar <%= m.nombre_comun %>">Editar</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('partials/componentes/paginacion', { pag, nombre: 'materiales' }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
