<%# Sin datos no hay qué recorrer: con error de carga no se ofrece el recorrido. %>
<%- include('partials/header', { activeTab: 'dashboard', titulo: 'Inicio', recorrido: errorCarga ? null : recorrido }) %>

<div class="flex flex-col gap-8">
  <div>
    <h1 class="titulo-pagina">Inicio</h1>
    <p class="mt-1 text-body-l text-on-surface-variant">Lo que necesita tu atención hoy y cómo va el reciclaje en Santander.</p>
  </div>

  <% if (errorCarga) { %>
    <%- include('partials/componentes/estado-error', { titulo: 'No pudimos cargar el inicio.', detalle: errorCarga, reintentar: '/dashboard' }) %>
  <% } else { %>

  <% if (erroresCarga && erroresCarga.length > 0) { %>
    <div class="nota nota-advertencia" role="alert">
      <span class="material-symbols-outlined" aria-hidden="true">warning</span>
      <p>Algunas cifras no se pudieron cargar (<%= erroresCarga.join(', ') %>) y aparecen en 0. <a class="enlace text-on-tertiary-container" href="/dashboard">Reintentar</a></p>
    </div>
  <% } %>

  <section aria-labelledby="tituloPendientes" class="flex flex-col gap-4" data-recorrido="pendientes">
    <h2 id="tituloPendientes" class="seccion-titulo">Pendientes de acción</h2>
    <%
      const tarjetasPendientes = [
        { cifra: pendientesAccion.gestoresPorRevisar, titulo: 'Gestores por revisar', texto: 'Empresas registradas desde la app que esperan aprobación.', href: '/gestores?estado=PENDIENTE', icono: 'how_to_reg' },
        { cifra: pendientesAccion.materialesPorVerificar, titulo: 'Materiales por verificar', texto: 'Materiales nuevos de gestores ya aprobados.', href: '/gestores?estado=APROBADO&por_verificar=1', icono: 'fact_check' },
        { cifra: pendientesAccion.problemasReportados, titulo: 'Problemas reportados', texto: 'Recolecciones que el generador reportó con problemas.', href: '/solicitudes?problema=1', icono: 'report' },
        { cifra: pendientesAccion.sinCertificado, titulo: 'Sin certificado hace más de 7 días', texto: 'Recolecciones sin certificado de disposición o aprovechamiento.', href: '/solicitudes?sin_certificado=1', icono: 'description' }
      ];
    %>
    <ul class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4" role="list">
      <% tarjetasPendientes.forEach(function (t) { %>
        <li>
          <a href="<%= t.href %>" class="tarjeta-accion h-full <%= t.cifra > 0 ? 'tarjeta-accion-activa' : '' %>">
            <span class="material-symbols-outlined" aria-hidden="true"><%= t.icono %></span>
            <span class="flex flex-1 flex-col">
              <span class="kpi-cifra text-inherit"><%= f.formatoNumero(t.cifra) %></span>
              <span class="text-title-s"><%= t.titulo %></span>
              <span class="text-body-s"><%= t.texto %></span>
            </span>
            <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
          </a>
        </li>
      <% }); %>
    </ul>
  </section>

  <section aria-labelledby="tituloPorRevisar" class="flex flex-col gap-4" data-recorrido="gestores">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="tituloPorRevisar" class="seccion-titulo">Gestores por revisar</h2>
      <a href="/gestores?estado=PENDIENTE" class="btn-text">Ver todos</a>
    </div>
    <% if (gestoresPendientes.length > 0) { %>
      <div class="tabla-contenedor" role="region" aria-labelledby="captionPorRevisar" tabindex="0">
        <table class="tabla">
          <caption id="captionPorRevisar" class="sr-only">Gestores por revisar, del más antiguo al más reciente</caption>
          <thead>
            <tr>
              <th scope="col">Empresa</th>
              <th scope="col">Municipio</th>
              <th scope="col">Registro</th>
              <th scope="col"><span class="sr-only">Acción</span></th>
            </tr>
          </thead>
          <tbody>
            <% gestoresPendientes.forEach(function (g) { %>
              <tr>
                <th scope="row">
                  <span class="flex items-center gap-3">
                    <%- include('partials/componentes/avatar', { nombre: g.razon_social, ruta: g.foto_perfil_path, tamano: 'md' }) %>
                    <span class="flex min-w-0 flex-col">
                      <%= g.razon_social || 'Sin razón social' %>
                      <span class="block text-body-s font-normal text-on-surface-variant">NIT <%= g.nit || 'sin dato' %></span>
                    </span>
                  </span>
                </th>
                <td><%= g.municipio ? f.capitalizar(g.municipio) : 'Sin dato' %></td>
                <td>
                  <%= f.fechaCorta(g.created_at) %>
                  <% if (g.permiso_path) { %><span class="block text-body-s text-on-surface-variant">Registrado desde la app, con permiso</span><% } %>
                </td>
                <td class="text-right">
                  <a href="/gestores/<%= g.id %>" class="btn-outlined btn-sm" aria-label="Revisar <%= g.razon_social %>">Revisar</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="tarjeta">
        <%- include('partials/componentes/estado-vacio', { icono: 'task_alt', titulo: 'Aún no hay gestores por revisar', texto: 'Cuando una empresa se registre desde la app, aparecerá aquí para revisar su permiso y sus materiales.' }) %>
      </div>
    <% } %>
  </section>

  <section aria-labelledby="tituloCifras" class="flex flex-col gap-4">
    <h2 id="tituloCifras" class="seccion-titulo">Cifras generales</h2>
    <dl class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
      <% [
        ['Solicitudes', kpis.totalSolicitudes],
        ['Publicadas', kpis.solicitudesPublicadas],
        ['En negociación', kpis.solicitudesEnProceso],
        ['Recolectadas', kpis.solicitudesRecolectadas],
        ['Canceladas', kpis.solicitudesCanceladas],
        ['Gestores', kpis.totalGestores],
        ['Gestores por revisar', kpis.gestoresPendientesCount],
        ['Gestores aprobados', kpis.gestoresAprobados],
        ['Gestores rechazados', kpis.gestoresRechazados],
        ['Postulaciones', kpis.totalPostulaciones]
      ].forEach(function (kpi) { %>
        <div class="tarjeta-kpi">
          <dt class="text-label-l text-on-surface-variant"><%= kpi[0] %></dt>
          <dd class="kpi-cifra"><%= f.formatoNumero(kpi[1]) %></dd>
        </div>
      <% }); %>
    </dl>
    <p class="text-body-m text-on-surface-variant">
      Catálogo: <a class="enlace" href="/materiales"><%= f.formatoNumero(kpis.totalMateriales) %> materiales</a>
      · <a class="enlace" href="/autoridades"><%= f.formatoNumero(kpis.totalAutoridades) %> autoridades ambientales</a>
      <% if (kpis.gestoresSuspendidos > 0) { %> · <%= f.formatoNumero(kpis.gestoresSuspendidos) %> gestores suspendidos<% } %>
    </p>
  </section>

  <%
    const estadosGrafico = [
      { etiqueta: 'Publicadas', valor: kpis.solicitudesPublicadas, color: '--eco-estado-publicado-color' },
      { etiqueta: 'En negociación', valor: kpis.solicitudesEnProceso, color: '--eco-estado-en-negociacion-color' },
      { etiqueta: 'Recolectadas', valor: kpis.solicitudesRecolectadas, color: '--eco-estado-recolectado-color' },
      { etiqueta: 'Canceladas', valor: kpis.solicitudesCanceladas, color: '--eco-estado-cancelado-color' }
    ];
  %>
  <section aria-labelledby="tituloGraficos" class="flex flex-col gap-4">
    <h2 id="tituloGraficos" class="seccion-titulo">Solicitudes en gráficos</h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <figure class="tarjeta flex flex-col gap-3" data-recorrido="graficos">
        <figcaption id="tituloGraficoEstados" class="tarjeta-titulo">Estado de las solicitudes</figcaption>
        <p id="descGraficoEstados" class="text-body-m text-on-surface-variant">
          <%= estadosGrafico.map(function (e) { return e.etiqueta + ': ' + f.formatoNumero(e.valor); }).join('; ') %>.
        </p>
        <div class="relative h-64">
          <canvas data-grafico="datosEstados" role="img" aria-labelledby="tituloGraficoEstados" aria-describedby="descGraficoEstados"></canvas>
        </div>
        <details>
          <summary class="btn-text w-fit">Ver como tabla</summary>
          <table class="tabla mt-2">
            <caption class="sr-only">Estado de las solicitudes</caption>
            <thead><tr><th scope="col">Estado</th><th scope="col" class="num">Solicitudes</th></tr></thead>
            <tbody>
              <% estadosGrafico.forEach(function (e) { %>
                <tr><th scope="row"><%= e.etiqueta %></th><td class="num"><%= f.formatoNumero(e.valor) %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      </figure>

      <figure class="tarjeta flex flex-col gap-3">
        <figcaption id="tituloGraficoMunicipios" class="tarjeta-titulo">Solicitudes por municipio</figcaption>
        <p id="descGraficoMunicipios" class="text-body-m text-on-surface-variant">
          <%= chartData.municipiosLabels.map(function (m, i) { return m + ': ' + f.formatoNumero(chartData.municipiosData[i]); }).join('; ') %>.
        </p>
        <div class="relative h-64">
          <canvas data-grafico="datosMunicipios" role="img" aria-labelledby="tituloGraficoMunicipios" aria-describedby="descGraficoMunicipios"></canvas>
        </div>
        <details>
          <summary class="btn-text w-fit">Ver como tabla</summary>
          <table class="tabla mt-2">
            <caption class="sr-only">Solicitudes por municipio</caption>
            <thead><tr><th scope="col">Municipio</th><th scope="col" class="num">Solicitudes</th></tr></thead>
            <tbody>
              <% chartData.municipiosLabels.forEach(function (m, i) { %>
                <tr><th scope="row"><%= m %></th><td class="num"><%= f.formatoNumero(chartData.municipiosData[i]) %></td></tr>
              <% }); %>
            </tbody>
          </table>
        </details>
      </figure>
    </div>
  </section>

  <% if (resumenReciclaje) { %>
    <section aria-labelledby="tituloResumenReciclaje" class="flex flex-col gap-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="tituloResumenReciclaje" class="seccion-titulo">Reciclaje por municipio</h2>
        <a href="/reportes" class="btn-filled">Ver reporte completo</a>
      </div>
      <div class="tabla-contenedor" role="region" aria-labelledby="captionResumenReciclaje" tabindex="0">
        <table class="tabla">
          <caption id="captionResumenReciclaje">Número de recolecciones confirmadas desde el inicio, por municipio</caption>
          <thead>
            <tr>
              <th scope="col">Municipio</th>
              <th scope="col" class="num">Recolecciones confirmadas</th>
              <th scope="col" class="num">Recolectadas sin confirmar</th>
            </tr>
          </thead>
          <tbody>
            <% resumenReciclaje.filas.forEach(function (fila) { %>
              <tr>
                <th scope="row"><%= fila.municipio %></th>
                <td class="num"><%= f.formatoNumero(fila.confirmadas) %></td>
                <td class="num"><%= f.formatoNumero(fila.sinConfirmar) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <td class="num"><%= f.formatoNumero(resumenReciclaje.total.confirmadas) %></td>
              <td class="num"><%= f.formatoNumero(resumenReciclaje.total.sinConfirmar) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  <% } %>

  <section aria-labelledby="tituloUltimas" class="flex flex-col gap-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="tituloUltimas" class="seccion-titulo">Últimas solicitudes</h2>
      <a href="/solicitudes" class="btn-text">Ver todas</a>
    </div>
    <% if (ultimasSolicitudes.length > 0) { %>
      <div class="tabla-contenedor" role="region" aria-labelledby="captionUltimas" tabindex="0">
        <table class="tabla">
          <caption id="captionUltimas" class="sr-only">Las 8 solicitudes más recientes</caption>
          <thead>
            <tr>
              <th scope="col">Material</th>
              <th scope="col" class="num">Cantidad</th>
              <th scope="col">Municipio</th>
              <th scope="col">Estado</th>
              <th scope="col">Fecha</th>
            </tr>
          </thead>
          <tbody>
            <% ultimasSolicitudes.forEach(function (s) { const mat = s.materiales_residuos || {}; %>
              <tr>
                <th scope="row">
                  <a class="enlace" href="/solicitudes/<%= s.id %>"><%= mat.nombre_comun || 'Solicitud ' + s.id %></a>
                  <span class="mt-1 block"><%- include('partials/componentes/chip-categoria', { categoria: mat.categoria }) %></span>
                </th>
                <td class="num"><%= f.formatoCantidad(s.cantidad_estimada, s.unidad_medida) %></td>
                <td><%= s.municipio ? f.capitalizar(s.municipio) : 'Sin dato' %></td>
                <td>
                  <%- include('partials/componentes/chip-estado', { estado: s.estado, tipo: 'solicitud' }) %>
                  <% if (s.problema_reportado) { %><span class="chip chip-estado-error mt-1"><span class="material-symbols-outlined" aria-hidden="true">report</span>Problema reportado</span><% } %>
                </td>
                <td class="whitespace-nowrap"><%= f.fechaCorta(s.created_at) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="tarjeta">
        <%- include('partials/componentes/estado-vacio', { titulo: 'Aún no hay solicitudes', texto: 'Cuando los generadores publiquen residuos desde la app, aparecerán aquí.' }) %>
      </div>
    <% } %>
  </section>

  <script type="application/json" id="datosEstados"><%- jsonParaScript({
    tipo: 'doughnut',
    serie: 'Solicitudes',
    etiquetas: estadosGrafico.map(function (e) { return e.etiqueta; }),
    valores: estadosGrafico.map(function (e) { return e.valor; }),
    colores: estadosGrafico.map(function (e) { return e.color; })
  }) %></script>
  <script type="application/json" id="datosMunicipios"><%- jsonParaScript({
    tipo: 'bar',
    serie: 'Solicitudes',
    etiquetas: chartData.municipiosLabels,
    valores: chartData.municipiosData,
    colores: ['--md-sys-color-primary']
  }) %></script>
  <script src="<%= recurso('/vendor/chart.umd.js') %>"></script>
  <% if (recorrido) { %>
    <script type="application/json" id="datosRecorrido"><%- jsonParaScript(recorrido) %></script>
    <script src="<%= recurso('/vendor/driver.js') %>" defer></script>
    <script src="<%= recurso('/js/recorrido.js') %>" defer></script>
  <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
