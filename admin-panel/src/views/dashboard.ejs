<%- include('partials/header', { activeTab: 'dashboard' }) %>

<div class="max-w-7xl mx-auto space-y-8">
  <%- include('partials/alert') %>

  <!-- Cabecera del Dashboard -->
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">
        <span>EcoManager Santander</span>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-bold">Panel Principal</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">Panel de Control Ambiental</h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
        Supervisión en tiempo real de recolecciones, gestión de residuos y certificación de gestores en Santander
      </p>
    </div>
    
  </header>

  <!-- Tarjetas KPI -->
  <section aria-label="Métricas Principales" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Total Solicitudes -->
    <div class="m3-surface-container p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Solicitudes</span>
        <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-400 flex items-center justify-center">
          <span class="material-symbols-outlined text-2xl">receipt_long</span>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= kpis.totalSolicitudes %></span>
        <span class="text-xs text-slate-500">publicadas</span>
      </div>
      <div class="mt-3 flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
        <span class="font-medium text-emerald-600 dark:text-emerald-400"><%= kpis.solicitudesPublicadas %> activas</span>
        <span>•</span>
        <span><%= kpis.solicitudesEnProceso %> en negociación</span>
      </div>
    </div>

    <!-- Solicitudes Recolectadas -->
    <div class="m3-surface-container p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Recolectadas</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 flex items-center justify-center">
          <span class="material-symbols-outlined text-2xl">check_circle</span>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-bold text-emerald-700 dark:text-emerald-400"><%= kpis.solicitudesRecolectadas %></span>
        <span class="text-xs text-slate-500">completadas</span>
      </div>
      <div class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        <% const tasa = kpis.totalSolicitudes > 0 ? Math.round((kpis.solicitudesRecolectadas / kpis.totalSolicitudes) * 100) : 0; %>
        <span class="font-semibold text-emerald-600 dark:text-emerald-400"><%= tasa %>%</span> tasa de efectividad
      </div>
    </div>

    <!-- Gestores Pendientes de Verificación -->
    <div class="m3-surface-container p-5 rounded-2xl border <%= kpis.gestoresPendientesCount > 0 ? 'border-amber-300 dark:border-amber-700 bg-amber-50/30 dark:bg-amber-950/10' : 'border-slate-200/80 dark:border-slate-800' %> hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Gestores Pendientes</span>
        <div class="w-10 h-10 rounded-xl <%= kpis.gestoresPendientesCount > 0 ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300' : 'bg-slate-100 dark:bg-slate-800 text-slate-600' %> flex items-center justify-center">
          <span class="material-symbols-outlined text-2xl">pending_actions</span>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-bold <%= kpis.gestoresPendientesCount > 0 ? 'text-amber-700 dark:text-amber-400' : 'text-slate-900 dark:text-slate-100' %>">
          <%= kpis.gestoresPendientesCount %>
        </span>
        <span class="text-xs text-slate-500">por auditar</span>
      </div>
      <div class="mt-3 text-xs">
        <% if (kpis.gestoresPendientesCount > 0) { %>
          <span class="text-amber-700 dark:text-amber-400 font-semibold flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">priority_high</span> Requieren revisión inmediata
          </span>
        <% } else { %>
          <span class="text-slate-500 dark:text-slate-400 font-medium">Al día sin pendientes</span>
        <% } %>
      </div>
    </div>

    <!-- Red de Gestores y Catálogo -->
    <div class="m3-surface-container p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Red Certificada</span>
        <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/50 text-purple-700 dark:text-purple-400 flex items-center justify-center">
          <span class="material-symbols-outlined text-2xl">verified</span>
        </div>
      </div>
      <div class="mt-4 flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900 dark:text-slate-100"><%= kpis.gestoresAprobados %></span>
        <span class="text-xs text-slate-500">gestores certificados</span>
      </div>
      <div class="mt-3 flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
        <span><%= kpis.totalMateriales %> tipos de residuos</span>
        <span>•</span>
        <span><%= kpis.totalAutoridades %> autoridades</span>
      </div>
    </div>
  </section>
  <!-- Panel de Gráficos (Añadido) -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-8">
    <div class="m3-surface-container p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800">
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-brand dark:text-emerald-400">pie_chart</span>
        Estado de las Solicitudes
      </h3>
      <div class="relative h-64 w-full">
        <canvas id="estadoSolicitudesChart"></canvas>
      </div>
    </div>
    
    <div class="m3-surface-container p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800">
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-brand dark:text-emerald-400">bar_chart</span>
        Solicitudes por Municipio
      </h3>
      <div class="relative h-64 w-full">
        <canvas id="municipiosChart"></canvas>
      </div>
    </div>
  </section>

  <!-- Sección de Auditoría Urgente de Gestores -->
  <% if (gestoresPendientes && gestoresPendientes.length > 0) { %>
    <section aria-labelledby="seccion-auditoria" class="m3-surface-container rounded-2xl border border-amber-200 dark:border-amber-800/80 p-6 bg-gradient-to-r from-amber-50/50 via-white to-amber-50/20 dark:from-amber-950/20 dark:via-slate-900 dark:to-amber-950/10">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        

      <div class="overflow-x-auto rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 uppercase font-semibold">
            <tr>
              <th class="py-3 px-4">Razón Social / NIT</th>
              <th class="py-3 px-4">Municipio</th>
              <th class="py-3 px-4">Contacto</th>
              <th class="py-3 px-4">Estado</th>
              <th class="py-3 px-4 text-right">Acción de Auditoría</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <% gestoresPendientes.forEach(g => { %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                <td class="py-3 px-4">
                  <div class="font-bold text-slate-900 dark:text-slate-100"><%= g.razon_social %></div>
                  <div class="text-[11px] font-mono text-slate-500">NIT: <%= g.nit %></div>
                </td>
                <td class="py-3 px-4 text-slate-700 dark:text-slate-300">
                  <%= g.municipio || 'Bucaramanga' %>
                </td>
                <td class="py-3 px-4 text-slate-600 dark:text-slate-400">
                  <div><%= g.email_contacto %></div>
                  <div class="text-[11px]"><%= g.telefono_contacto %></div>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">
                    PENDIENTE
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <form action="/gestores/estado/<%= g.id %>" method="POST" onsubmit="return confirm('¿Confirmas la APROBACIÃ“N formal de este gestor ambiental para operar en Santander?');" class="inline">
                      <input type="hidden" name="estado" value="APROBADO">
                      <input type="hidden" name="redirectUrl" value="/dashboard">
                      <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white transition flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">check</span>
                        <span>Aprobar</span>
                      </button>
                    </form>
                    <form action="/gestores/estado/<%= g.id %>" method="POST" onsubmit="return confirm('¿Confirmas el RECHAZO formal de esta solicitud de gestor ambiental?');" class="inline">
                      <input type="hidden" name="estado" value="RECHAZADO">
                      <input type="hidden" name="redirectUrl" value="/dashboard">
                      <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white transition flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">close</span>
                        <span>Rechazar</span>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

  <!-- Panel de dos columnas: Solicitudes Recientes y Accesos Rápidos -->
  <div class="grid grid-cols-1 gap-6">
    <!-- Ãšltimas Solicitudes Registradas (2 Cols) -->
    <div class="m3-surface-container rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
            <span class="material-symbols-outlined text-brand dark:text-emerald-400">history</span>
            <span>Solicitudes Recientes en Santander</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Ãšltimos residuos reportados por generadores en la plataforma</p>
        </div>
      </div>

      <% if (ultimasSolicitudes && ultimasSolicitudes.length > 0) { %>
        <div class="overflow-x-auto rounded-xl border border-slate-100 dark:border-slate-800">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 uppercase font-semibold">
              <tr>
                <th class="py-3 px-4">Residuo</th>
                <th class="py-3 px-4">Cantidad</th>
                <th class="py-3 px-4">Municipio</th>
                <th class="py-3 px-4">Estado</th>
                <th class="py-3 px-4">Fecha</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              <% ultimasSolicitudes.forEach(s => { 
                const mat = s.materiales_residuos || {};
                let badgeClass = 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300';
                if (s.estado === 'RECOLECTADO') badgeClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
                else if (s.estado === 'EN_NEGOCIACION') badgeClass = 'bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300';
                else if (s.estado === 'PUBLICADO') badgeClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300';
                else if (s.estado === 'CANCELADO') badgeClass = 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300';
              %>
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition">
                  <td class="py-3 px-4">
                    <div class="font-bold text-slate-900 dark:text-slate-100"><%= mat.nombre_comun || 'Residuo #' + s.id %></div>
                    <div class="text-[11px] text-slate-500 font-mono"><%= mat.codigo || 'S/' + s.id %></div>
                  </td>
                  <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-200">
                    <%= s.cantidad_estimada %> <span class="text-xs font-normal text-slate-500"><%= s.unidad_medida %></span>
                  </td>
                  <td class="py-3 px-4 text-slate-600 dark:text-slate-400 capitalize">
                    <%= (s.municipio || 'Bucaramanga').toLowerCase() %>
                  </td>
                  <td class="py-3 px-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wide uppercase <%= badgeClass %>">
                      <%= s.estado %>
                    </span>
                  </td>
                  <td class="py-3 px-4 text-slate-500 text-[11px]">
                    <%= s.created_at ? new Date(s.created_at).toLocaleDateString('es-CO', { day: '2-digit', month: 'short' }) : '-' %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="py-12 text-center text-xs text-slate-400 italic">
          No hay solicitudes de recolección registradas aún.
        </div>
      <% } %>
    </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Datos inyectados desde el Controller
    const kpis = <%- JSON.stringify(kpis || {}) %>;
    const chartData = <%- JSON.stringify(chartData || {municipiosLabels:[], municipiosData:[]}) %>;
    
    // Variables de color para Dark Mode (Opcional, pero se ve mejor)
    const isDarkMode = document.documentElement.classList.contains('dark');
    const textColor = isDarkMode ? '#cbd5e1' : '#475569';
    const gridColor = isDarkMode ? '#334155' : '#e2e8f0';

    Chart.defaults.color = textColor;
    Chart.defaults.font.family = "'Roboto', sans-serif";

    // 1. Gráfico de Dona: Estado de Solicitudes
    const ctxEstado = document.getElementById('estadoSolicitudesChart').getContext('2d');
    new Chart(ctxEstado, {
      type: 'doughnut',
      data: {
        labels: ['Recolectadas', 'En Negociación', 'Publicadas', 'Canceladas'],
        datasets: [{
          data: [
            kpis.solicitudesRecolectadas || 0, 
            kpis.solicitudesEnProceso || 0, 
            kpis.solicitudesPublicadas || 0, 
            kpis.solicitudesCanceladas || 0
          ],
          backgroundColor: [
            '#10B981', // Emerald 500
            '#3B82F6', // Blue 500
            '#F59E0B', // Amber 500
            '#EF4444'  // Red 500
          ],
          borderWidth: 0,
          hoverOffset: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'right' }
        },
        cutout: '70%'
      }
    });

    // 2. Gráfico de Barras: Municipios
    const ctxMuni = document.getElementById('municipiosChart').getContext('2d');
    new Chart(ctxMuni, {
      type: 'bar',
      data: {
        labels: chartData.municipiosLabels.length ? chartData.municipiosLabels : ['Bucaramanga', 'Floridablanca'],
        datasets: [{
          label: 'Total Reportes',
          data: chartData.municipiosData.length ? chartData.municipiosData : [0, 0],
          backgroundColor: '#16A34A', // Brand
          borderRadius: 6,
          barThickness: 32
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: { 
            beginAtZero: true,
            ticks: { precision: 0 },
            grid: { color: gridColor }
          },
          x: {
            grid: { display: false }
          }
        }
      }
    });
  });
</script>
<%- include('partials/footer') %>





