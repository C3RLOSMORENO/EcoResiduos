<!DOCTYPE html>
<html lang="es" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Restablecer contraseña - EcoManager Panel Santander">
    <title>Restablecer Contraseña - EcoManager Panel Santander</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            DEFAULT: '#1E4620',
                            hover: '#163518',
                            subtle: '#E8F0E6',
                        },
                        primary: '#1E4620',
                        'on-primary': '#FFFFFF',
                        'primary-container': '#2D5B30',
                        'surface-light': '#FFFFFF',
                        'surface-dark': '#1E293B',
                        'bg-light': '#F9FAFB',
                        'bg-dark': '#0F172A'
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/main.js" defer></script>
</head>

<body class="min-h-screen w-full flex items-center justify-center bg-[#F9FAFB] dark:bg-[#0F172A] p-4 sm:p-6 lg:p-8 font-sans text-slate-900 dark:text-slate-100 antialiased">
    <main class="w-full max-w-md my-auto">
        <!-- Tarjeta idéntica a login.ejs -->
        <div class="bg-white dark:bg-[#1E293B] rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-xl p-8 sm:p-10 transition-all">
            <div class="flex flex-col items-center text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-4 text-brand dark:text-emerald-400">
                    <span class="material-symbols-outlined text-4xl" aria-hidden="true">lock_reset</span>
                </div>
                <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">Restablecer Contraseña</h1>
                <p class="text-xs font-semibold text-brand dark:text-emerald-400 uppercase tracking-wider mt-1">EcoManager Santander</p>
                <p id="subtituloEstado" class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                    Ingresa tu correo para recibir el código de verificación de 8 dígitos.
                </p>
            </div>

            <%- include('partials/alert') %>

            <!-- ========================================== -->
            <!-- PASO 1: Ingreso de Correo Electrónico      -->
            <!-- ========================================== -->
            <form id="formPasoEmail" class="space-y-5" novalidate>
                <div>
                    <label for="correoRecuperar" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Correo Electrónico <span class="text-red-600" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
                        </div>
                        <input 
                            type="email" 
                            id="correoRecuperar" 
                            name="email"
                            required 
                            autocomplete="email"
                            placeholder="admin@ecoresiduos.org"
                            class="input-ui !pl-11"
                            autofocus
                        >
                    </div>
                </div>

                <div class="pt-2 space-y-3">
                    <button 
                        type="submit" 
                        id="btnEnviarOtp" 
                        class="btn-primary w-full !h-11 flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">send</span>
                        <span id="btnEnviarOtpTexto">Enviar código de recuperación</span>
                    </button>

                    <a 
                        href="/login" 
                        class="btn-tonal w-full !h-11 flex items-center justify-center gap-2 text-center"
                    >
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_back</span>
                        <span>Volver al Inicio de Sesión</span>
                    </a>
                </div>
            </form>

            <!-- ========================================== -->
            <!-- PASO 2: Código + Nueva Contraseña          -->
            <!-- ========================================== -->
            <form id="formPasoClave" class="space-y-5 hidden" novalidate>
                
                <!-- Pill Informativo de Correo Destino -->
                <div class="flex items-center justify-between rounded-xl bg-slate-50 dark:bg-slate-800/70 p-3 border border-slate-200/80 dark:border-slate-700/80 text-xs">
                    <div class="flex items-center gap-2 overflow-hidden">
                        <span class="material-symbols-outlined text-base text-brand dark:text-emerald-400 shrink-0" aria-hidden="true">mark_email_read</span>
                        <span class="text-slate-500 dark:text-slate-400 shrink-0">Enviado a:</span>
                        <span id="correoDestinoTexto" class="font-semibold text-slate-800 dark:text-slate-200 truncate"></span>
                    </div>
                    <button 
                        type="button" 
                        id="btnCambiarCorreo" 
                        class="text-xs font-semibold text-brand dark:text-emerald-400 hover:underline shrink-0 ml-2"
                    >
                        Cambiar
                    </button>
                </div>

                <!-- Código OTP (Centrado matemáticamente, sin icono que desplace) -->
                <div>
                    <label for="codigoOtp" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Código de verificación (8 dígitos) <span class="text-red-600" aria-hidden="true">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="codigoOtp" 
                        required 
                        maxlength="8" 
                        placeholder="••••••••" 
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        class="input-ui text-center text-2xl font-mono font-bold tracking-[0.35em]"
                    >
                    <p class="text-[11px] text-slate-400 mt-1.5 text-center flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-xs" aria-hidden="true">info</span>
                        <span>Revisa tu bandeja de entrada o spam</span>
                    </p>
                </div>

                <!-- Nueva Contraseña -->
                <div>
                    <label for="nuevaClave" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Nueva Contraseña <span class="text-red-600" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">lock</span>
                        </div>
                        <input 
                            type="password" 
                            id="nuevaClave" 
                            required 
                            minlength="6" 
                            placeholder="Mínimo 6 caracteres" 
                            autocomplete="new-password"
                            class="input-ui !pl-11 !pr-12"
                        >
                        <button 
                            type="button" 
                            class="btn-toggle-pass absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 focus:outline-none rounded-lg transition-colors"
                            data-target="nuevaClave" 
                            aria-label="Mostrar contraseña"
                        >
                            <span class="material-symbols-outlined text-xl select-none" aria-hidden="true">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Confirmar Contraseña -->
                <div>
                    <label for="confirmarClave" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Confirmar Contraseña <span class="text-red-600" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">lock</span>
                        </div>
                        <input 
                            type="password" 
                            id="confirmarClave" 
                            name="confirmarClave"
                            required 
                            minlength="6" 
                            placeholder="Repite la contraseña" 
                            autocomplete="new-password"
                            class="input-ui !pl-11 !pr-12"
                        >
                        <button 
                            type="button" 
                            class="btn-toggle-pass absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 focus:outline-none rounded-lg transition-colors"
                            data-target="confirmarClave" 
                            aria-label="Mostrar contraseña"
                        >
                            <span class="material-symbols-outlined text-xl select-none" aria-hidden="true">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Acciones Paso 2 -->
                <div class="pt-2 space-y-3">
                    <button 
                        type="submit" 
                        id="btnConfirmarCambio" 
                        class="btn-primary w-full !h-11 flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">check_circle</span>
                        <span id="btnConfirmarTexto">Restablecer contraseña y entrar</span>
                    </button>

                    <button 
                        type="button" 
                        id="btnCancelarPaso2" 
                        class="btn-tonal w-full !h-11 flex items-center justify-center gap-2 text-center"
                    >
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_back</span>
                        <span>Cancelar</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <!-- Supabase JS & Lógica del Flujo OTP -->
    <script type="module">
        import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

        const supabaseUrl = '<%= typeof supabaseUrl !== "undefined" ? supabaseUrl : process.env.SUPABASE_URL %>';
        const supabaseAnonKey = '<%= typeof supabaseAnonKey !== "undefined" ? supabaseAnonKey : process.env.SUPABASE_ANON_KEY %>';
        const supabase = createClient(supabaseUrl, supabaseAnonKey);

        let correoGuardado = '';

        function notificar(mensaje, esError = false) {
            if (typeof window.mostrarNotificacion === 'function') {
                window.mostrarNotificacion(mensaje, esError);
            }
        }

        // Toggles de visibilidad de contraseñas con Material Symbols
        document.querySelectorAll('.btn-toggle-pass').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetInput = document.getElementById(btn.getAttribute('data-target'));
                const icon = btn.querySelector('.material-symbols-outlined');
                if (targetInput && icon) {
                    const esPass = targetInput.getAttribute('type') === 'password';
                    targetInput.setAttribute('type', esPass ? 'text' : 'password');
                    icon.textContent = esPass ? 'visibility_off' : 'visibility';
                }
            });
        });

        // Filtro numérico en tiempo real para el código OTP (8 dígitos)
        const inputOtp = document.getElementById('codigoOtp');
        inputOtp.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/\D/g, '').slice(0, 8);
        });

        // PASO 1: Envío de OTP
        document.getElementById('formPasoEmail').addEventListener('submit', async (e) => {
            e.preventDefault();
            correoGuardado = document.getElementById('correoRecuperar').value.trim();
            const btn = document.getElementById('btnEnviarOtp');
            const btnTexto = document.getElementById('btnEnviarOtpTexto');

            if (!correoGuardado) {
                notificar('Por favor ingresa un correo electrónico válido.', true);
                return;
            }

            btn.disabled = true;
            btnTexto.textContent = 'Enviando código...';

            const { error } = await supabase.auth.resetPasswordForEmail(correoGuardado);

            if (error) {
                notificar(error.message, true);
                btn.disabled = false;
                btnTexto.textContent = 'Enviar código de recuperación';
            } else {
                notificar(`Código de 8 dígitos enviado a ${correoGuardado}.`);
                document.getElementById('correoDestinoTexto').textContent = correoGuardado;
                document.getElementById('formPasoEmail').classList.add('hidden');
                document.getElementById('formPasoClave').classList.remove('hidden');
                document.getElementById('subtituloEstado').textContent = 'Ingresa el código de 8 dígitos recibido y define tu nueva contraseña';
                inputOtp.focus();
            }
        });

        // Cancelar y volver al Paso 1
        const volverAPaso1 = () => {
            document.getElementById('formPasoClave').classList.add('hidden');
            document.getElementById('formPasoEmail').classList.remove('hidden');
            document.getElementById('subtituloEstado').textContent = 'Ingresa tu correo para recibir el código de verificación de 8 dígitos.';
            const btn = document.getElementById('btnEnviarOtp');
            btn.disabled = false;
            document.getElementById('btnEnviarOtpTexto').textContent = 'Enviar código de recuperación';
            document.getElementById('correoRecuperar').focus();
        };

        document.getElementById('btnCambiarCorreo').addEventListener('click', volverAPaso1);
        document.getElementById('btnCancelarPaso2').addEventListener('click', volverAPaso1);

        // PASO 2: Validación de OTP y cambio de contraseña
        document.getElementById('formPasoClave').addEventListener('submit', async (e) => {
            e.preventDefault();
            const token = inputOtp.value.trim();
            const password = document.getElementById('nuevaClave').value;
            const confirmacion = document.getElementById('confirmarClave').value;
            const btn = document.getElementById('btnConfirmarCambio');
            const btnTexto = document.getElementById('btnConfirmarTexto');

            if (!token || token.length < 6) {
                notificar('Ingresa el código de verificación de 8 dígitos.', true);
                return;
            }

            if (password.length < 6) {
                notificar('La contraseña debe tener al menos 6 caracteres.', true);
                return;
            }

            if (password !== confirmacion) {
                notificar('Las contraseñas no coinciden. Por favor verifícalas.', true);
                return;
            }

            btn.disabled = true;
            btnTexto.textContent = 'Validando código...';

            const { error: errorOtp } = await supabase.auth.verifyOtp({
                email: correoGuardado,
                token: token,
                type: 'recovery'
            });

            if (errorOtp) {
                notificar('Código incorrecto o expirado. Revisa los 8 dígitos.', true);
                btn.disabled = false;
                btnTexto.textContent = 'Restablecer contraseña y entrar';
                return;
            }

            btnTexto.textContent = 'Actualizando contraseña...';
            const { error: errorPass } = await supabase.auth.updateUser({ password });

            if (errorPass) {
                notificar('Error al guardar contraseña: ' + errorPass.message, true);
                btn.disabled = false;
                btnTexto.textContent = 'Restablecer contraseña y entrar';
            } else {
                notificar('¡Contraseña actualizada con éxito! Redirigiendo al login...');
                setTimeout(() => {
                    window.location.href = '/login?msg=Contrase%C3%B1a+actualizada+con+%C3%A9xito&type=success';
                }, 1200);
            }
        });
    </script>
</body>

</html>


