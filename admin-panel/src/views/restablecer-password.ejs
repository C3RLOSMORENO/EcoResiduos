<!DOCTYPE html>
<html lang="es-CO">
<head>
  <%- include('partials/head', { titulo: 'Restablecer contraseña' }) %>
  <meta name="description" content="Restablecer la contraseña del panel de administración de EcoResiduos">
</head>
<body class="fondo-autenticacion relative">
  <a href="#contenido" class="saltar">Saltar al contenido</a>

  <header class="absolute top-0 right-0 p-4 sm:p-6 z-10">
    <button type="button" id="botonTema" class="btn-icono rounded-full border border-outline-variant bg-surface-container-low transition-colors hover:bg-surface-container hover:border-outline focus-visible:ring-2 focus-visible:ring-primary" aria-pressed="false" aria-label="Modo oscuro">
      <span class="material-symbols-outlined icono-20" aria-hidden="true" data-icono-tema>dark_mode</span>
    </button>
  </header>

  <main id="contenido" tabindex="-1" class="flex flex-1 items-center justify-center px-4 py-8 sm:py-12">
    <div class="w-full max-w-[420px]">
      <div class="tarjeta-login p-6 sm:p-8 md:p-10">
        <div class="mb-6 text-center">
          <div class="insignia-logo mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#FFFFFF]">
            <img src="/images/isotipo-192.png" alt="EcoResiduos" width="36" height="36" class="h-9 w-9 object-contain">
          </div>
          <h1 class="font-display text-headline-m text-on-surface">Restablecer contraseña</h1>
          <p id="subtituloPaso" class="mt-1 text-body-m text-on-surface-variant">Escribe tu correo y te enviaremos un código de 8 dígitos.</p>
        </div>

      <%- include('partials/alert') %>

      <noscript>
        <p class="nota nota-advertencia mb-4">Para restablecer la contraseña el navegador debe tener JavaScript activo.</p>
      </noscript>

      <form id="formPasoEmail" class="flex flex-col gap-4" data-validar>
        <div class="campo">
          <label for="correoRecuperar" class="campo-etiqueta">Correo</label>
          <div class="campo-con-icono">
            <span class="campo-icono-prefijo" aria-hidden="true">
              <span class="material-symbols-outlined icono-20">mail</span>
            </span>
            <input type="email" id="correoRecuperar" name="email" required autocomplete="email" inputmode="email" placeholder="admin@ecoresiduos.com" class="campo-control">
          </div>
        </div>
        <button type="submit" id="btnEnviarOtp" class="btn-filled w-full h-12 text-label-l font-semibold">
          <span class="material-symbols-outlined icono-20" aria-hidden="true">send</span>
          <span id="btnEnviarOtpTexto">Enviar código</span>
        </button>
        <a href="/login" class="btn-text self-center">Volver a iniciar sesión</a>
      </form>

      <form id="formPasoClave" class="flex flex-col gap-4" data-validar hidden>
        <p class="nota nota-info">
          <span class="material-symbols-outlined" aria-hidden="true">mark_email_read</span>
          <span>Si <strong id="correoDestinoTexto"></strong> tiene acceso al panel, le enviamos el código. Puede tardar unos minutos; revisa también la carpeta de spam.</span>
        </p>
        <div class="campo">
          <label for="codigoOtp" class="campo-etiqueta">Código de 8 dígitos</label>
          <input type="text" id="codigoOtp" required minlength="6" maxlength="8" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,8}" data-mensaje-formato="Escribe solo los dígitos del código." class="campo-control text-center font-semibold tracking-[0.3em]">
        </div>
        <div class="campo">
          <label for="nuevaClave" class="campo-etiqueta">Nueva contraseña</label>
          <input type="password" id="nuevaClave" required minlength="6" autocomplete="new-password" class="campo-control" aria-describedby="nuevaClaveAyuda">
          <p id="nuevaClaveAyuda" class="campo-ayuda">Mínimo 6 caracteres.</p>
        </div>
        <div class="campo">
          <label for="confirmarClave" class="campo-etiqueta">Repite la contraseña</label>
          <input type="password" id="confirmarClave" required minlength="6" autocomplete="new-password" class="campo-control">
        </div>
        <label class="casilla"><input type="checkbox" id="verClaves"> Mostrar contraseñas</label>
        <button type="submit" id="btnConfirmarCambio" class="btn-filled w-full h-12 text-label-l font-semibold">
          <span class="material-symbols-outlined icono-20" aria-hidden="true">check_circle</span>
          <span id="btnConfirmarTexto">Guardar contraseña</span>
        </button>
        <button type="button" id="btnCambiarCorreo" class="btn-text self-center">Usar otro correo</button>
      </form>
    </div>
  </div>
</main>

  <footer class="py-6 text-center text-body-s text-on-surface-variant opacity-70">
    <p>EcoResiduos · Panel de administración · Santander</p>
  </footer>

  <script type="application/json" id="configuracionSupabase"><%- configuracionSupabase %></script>
  <script src="/vendor/supabase.js" defer></script>
  <script src="/js/restablecer.js" defer></script>
</body>
</html>
