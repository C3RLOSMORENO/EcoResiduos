<%
  const creando = modo === 'crear';
  const tituloPagina = creando ? 'Nuevo gestor' : 'Editar ' + (gestor.razon_social || 'gestor');
  const porVerificar = gestor.material_ids_por_verificar || [];
  const seleccionados = gestor.material_ids || [];
  const municipioGuardado = gestor.municipio ? f.capitalizar(gestor.municipio) : '';
  const municipioEnLista = MUNICIPIOS.find(function (m) { return m.toLowerCase() === String(gestor.municipio || '').toLowerCase() || m.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase() === String(gestor.municipio || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); });
  const accion = creando ? '/gestores/guardar' : '/gestores/edit/' + gestor.id;
%>
<%- include('partials/header', { activeTab: 'gestores', titulo: tituloPagina }) %>

<div class="flex flex-col gap-6">
  <nav aria-label="Ruta de navegación" class="text-body-m">
    <ol class="flex flex-wrap items-center gap-1" role="list">
      <li><a class="enlace" href="/gestores">Gestores</a></li>
      <% if (!creando) { %>
        <li aria-hidden="true">/</li>
        <li><a class="enlace" href="/gestores/<%= gestor.id %>"><%= gestor.razon_social %></a></li>
      <% } %>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-on-surface-variant"><%= creando ? 'Nuevo' : 'Editar' %></li>
    </ol>
  </nav>

  <div>
    <h1 class="titulo-pagina"><%= tituloPagina %></h1>
    <p class="mt-1 text-body-l text-on-surface-variant">
      <%= creando ? 'Registra una empresa autorizada. Queda aprobada y con los materiales que marques verificados.' : 'Corrige los datos, el estado y los materiales del gestor.' %>
    </p>
  </div>

  <form action="<%= accion %>" method="POST" class="flex flex-col gap-6" data-validar data-conservar id="formGestor">
    <section aria-labelledby="tituloDatosForm" class="tarjeta flex flex-col gap-4">
      <h2 id="tituloDatosForm" class="tarjeta-titulo">Datos de la empresa</h2>
      <p class="campo-ayuda">Los campos marcados con «obligatorio» se deben llenar.</p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="campo">
          <label for="nit" class="campo-etiqueta">NIT <span class="campo-obligatorio">(obligatorio)</span></label>
          <input type="text" id="nit" name="nit" required value="<%= gestor.nit || '' %>" data-format="nit" inputmode="numeric"
                 pattern="[0-9]{8,15}(-[0-9])?" data-mensaje-formato="Escribe entre 8 y 15 dígitos; puedes agregar el dígito de verificación con guion."
                 class="campo-control" aria-describedby="nitAyuda">
          <p id="nitAyuda" class="campo-ayuda">Sin puntos. Ejemplo: 900396512 o 900396512-1.</p>
        </div>
        <div class="campo">
          <label for="razon_social" class="campo-etiqueta">Razón social <span class="campo-obligatorio">(obligatorio)</span></label>
          <input type="text" id="razon_social" name="razon_social" required minlength="3" maxlength="200" value="<%= gestor.razon_social || '' %>" autocomplete="organization" class="campo-control">
        </div>
        <div class="campo">
          <label for="municipio" class="campo-etiqueta">Municipio <span class="campo-obligatorio">(obligatorio)</span></label>
          <select id="municipio" name="municipio" required class="campo-control">
            <option value="">Elige un municipio</option>
            <% MUNICIPIOS.forEach(function (m) { %>
              <option value="<%= m %>" <%= municipioEnLista === m ? 'selected' : '' %>><%= m %></option>
            <% }); %>
            <% if (!creando && gestor.municipio && !municipioEnLista) { %>
              <option value="<%= gestor.municipio %>" selected><%= municipioGuardado %> (fuera de la lista)</option>
            <% } %>
          </select>
        </div>
        <div class="campo">
          <label for="direccion" class="campo-etiqueta">Dirección <span class="campo-obligatorio">(obligatorio)</span></label>
          <input type="text" id="direccion" name="direccion" required minlength="5" maxlength="255" value="<%= gestor.direccion || '' %>" autocomplete="street-address" class="campo-control" aria-describedby="direccionAyuda">
          <p id="direccionAyuda" class="campo-ayuda">Se ubica en el mapa con OpenStreetMap solo si cambia la dirección o el municipio.</p>
        </div>
        <div class="campo">
          <label for="representante_legal" class="campo-etiqueta">Representante o contacto</label>
          <input type="text" id="representante_legal" name="representante_legal" maxlength="150" value="<%= gestor.representante_legal || '' %>" autocomplete="name" class="campo-control">
        </div>
        <div class="campo">
          <label for="telefono_contacto" class="campo-etiqueta">Teléfono <span class="campo-obligatorio">(obligatorio)</span></label>
          <input type="tel" id="telefono_contacto" name="telefono_contacto" required maxlength="30" value="<%= gestor.telefono_contacto || '' %>" data-format="phone" autocomplete="tel" class="campo-control">
        </div>
        <div class="campo">
          <label for="email_contacto" class="campo-etiqueta">Correo <span class="campo-obligatorio">(obligatorio)</span></label>
          <input type="email" id="email_contacto" name="email_contacto" required maxlength="150" value="<%= gestor.email_contacto || '' %>" autocomplete="email" class="campo-control" aria-describedby="emailAyuda">
          <p id="emailAyuda" class="campo-ayuda">Con este correo la empresa vincula su cuenta en la app.</p>
        </div>
        <div class="campo">
          <label for="horario" class="campo-etiqueta">Horario de atención</label>
          <input type="text" id="horario" name="horario" maxlength="120" value="<%= gestor.horario || '' %>" class="campo-control" aria-describedby="horarioAyuda">
          <p id="horarioAyuda" class="campo-ayuda">Ejemplo: lun a vie 7:30 a 17:00 · sáb 8:00 a 12:00. Máximo 120 caracteres.</p>
        </div>
      </div>
    </section>

    <% if (!creando) { %>
      <section aria-labelledby="tituloEstadoForm" class="tarjeta flex flex-col gap-4">
        <h2 id="tituloEstadoForm" class="tarjeta-titulo">Estado</h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="campo">
            <label for="estado_verificacion" class="campo-etiqueta">Estado de verificación <span class="campo-obligatorio">(obligatorio)</span></label>
            <select id="estado_verificacion" name="estado_verificacion" required class="campo-control" aria-describedby="estadoAyuda">
              <% ['PENDIENTE', 'APROBADO', 'RECHAZADO', 'SUSPENDIDO'].forEach(function (e) { %>
                <option value="<%= e %>" <%= gestor.estado_verificacion === e ? 'selected' : '' %>><%= f.etiquetaVerificacion(e) %></option>
              <% }); %>
            </select>
            <p id="estadoAyuda" class="campo-ayuda">Si lo cambias a Aprobado, los materiales que queden marcados se verifican.</p>
          </div>
          <div class="campo">
            <label for="motivo" class="campo-etiqueta">Motivo, si lo rechazas o suspendes</label>
            <textarea id="motivo" name="motivo" rows="2" maxlength="300" class="campo-control" aria-describedby="motivoAyuda"></textarea>
            <p id="motivoAyuda" class="campo-ayuda">El gestor lo recibe en su notificación. Máximo 300 caracteres.</p>
          </div>
          <div class="md:col-span-2">
            <input type="hidden" name="disponible_enviado" value="1">
            <label class="casilla" for="disponible">
              <input type="checkbox" id="disponible" name="disponible" value="true" <%= gestor.disponible !== false ? 'checked' : '' %>>
              Disponible para recolectar
            </label>
          </div>
        </div>
      </section>
    <% } %>

    <section aria-labelledby="tituloMaterialesForm" class="tarjeta flex flex-col gap-4" data-lista-materiales>
      <h2 id="tituloMaterialesForm" class="tarjeta-titulo">Materiales que recibe</h2>
      <% if (!creando) { %>
        <div class="nota nota-info">
          <span class="material-symbols-outlined" aria-hidden="true">info</span>
          <p>Guardar no cambia la verificación: los materiales que ya tenía conservan su estado, los que marques nuevos quedan verificados y los que desmarques se quitan. Para verificar los pendientes usa los botones del detalle del gestor.</p>
        </div>
      <% } %>
      <% if (porVerificar.length > 0) { %>
        <p class="text-body-m"><strong><%= porVerificar.length %></strong> material(es) por verificar: el gestor no ve sus solicitudes hasta que se verifiquen.</p>
      <% } %>
      <div class="flex flex-wrap items-end gap-3">
        <div class="campo min-w-0 flex-1">
          <label for="filtroMateriales" class="campo-etiqueta">Buscar en la lista</label>
          <input type="search" id="filtroMateriales" class="campo-control" data-filtro-materiales aria-describedby="filtroMaterialesAyuda">
          <p id="filtroMaterialesAyuda" class="campo-ayuda">Código, nombre o categoría.</p>
        </div>
        <div class="flex gap-2 pb-6">
          <button type="button" class="btn-outlined btn-sm" data-marcar-todos>Todos</button>
          <button type="button" class="btn-outlined btn-sm" data-marcar-ninguno>Ninguno</button>
        </div>
      </div>
      <p class="text-label-l" data-contador-materiales aria-live="polite"><%= seleccionados.length %> materiales seleccionados</p>

      <% if (materialesDisponibles && materialesDisponibles.length > 0) { %>
        <fieldset>
          <legend class="sr-only">Materiales</legend>
          <ul class="grid max-h-96 grid-cols-1 gap-2 overflow-y-auto rounded-sm bg-surface-container-low p-2 md:grid-cols-2 xl:grid-cols-3" role="list">
            <% materialesDisponibles.forEach(function (mat) {
              const marcado = seleccionados.includes(mat.id);
              const busqueda = ((mat.codigo || '') + ' ' + (mat.nombre_comun || '') + ' ' + f.etiquetaCategoria(mat.categoria)).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
            %>
              <li data-material-item data-busqueda="<%= busqueda %>">
                <% if (!creando && marcado) { %><input type="hidden" name="materiales_presentes[]" value="<%= mat.id %>"><% } %>
                <label for="mat_<%= mat.id %>" class="flex min-h-[44px] cursor-pointer items-start gap-3 rounded-sm bg-surface-container-lowest p-3">
                  <input type="checkbox" id="mat_<%= mat.id %>" name="materiales_ids[]" value="<%= mat.id %>" <%= marcado ? 'checked' : '' %> class="mt-0.5">
                  <span class="flex min-w-0 flex-col gap-1">
                    <span class="font-semibold"><%= mat.nombre_comun %></span>
                    <span class="flex flex-wrap items-center gap-1">
                      <span class="text-body-s text-on-surface-variant"><%= mat.codigo %></span>
                      <%- include('partials/componentes/chip-categoria', { categoria: mat.categoria }) %>
                      <% if (porVerificar.includes(mat.id)) { %><span class="chip chip-estado-en-negociacion">Por verificar</span><% } %>
                    </span>
                  </span>
                </label>
              </li>
            <% }); %>
          </ul>
        </fieldset>
      <% } else { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'category', titulo: 'No hay materiales en el catálogo', texto: 'Crea primero los materiales.', accion: { href: '/materiales/nuevo', texto: 'Nuevo material' } }) %>
      <% } %>
    </section>

    <div class="flex flex-wrap justify-end gap-2">
      <a href="<%= creando ? '/gestores' : '/gestores/' + gestor.id %>" class="btn-text">Cancelar</a>
      <button type="submit" class="btn-filled" data-cargando="Guardando…">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">save</span>
        <span data-etiqueta><%= creando ? 'Registrar gestor' : 'Guardar cambios' %></span>
      </button>
    </div>
  </form>

  <% if (!creando) { %>
    <section id="seccionPermiso" aria-labelledby="tituloPermisoForm" class="tarjeta flex flex-col gap-4">
      <h2 id="tituloPermisoForm" class="tarjeta-titulo">Permiso ambiental (PDF)</h2>
      <p class="text-body-m text-on-surface-variant">
        <%= gestor.tiene_permiso ? 'Ya tiene un permiso adjunto. Si subes otro, lo reemplaza.' : 'Este gestor no tiene permiso adjunto.' %>
        Solo PDF de máximo 10 MB.
      </p>
      <form id="formPermiso" action="/gestores/<%= gestor.id %>/permiso" method="POST" enctype="multipart/form-data" class="flex flex-wrap items-end gap-3">
        <div class="campo min-w-0 flex-1">
          <label for="archivoPermiso" class="campo-etiqueta">Archivo del permiso</label>
          <input type="file" id="archivoPermiso" name="permiso" accept="application/pdf,.pdf" required class="campo-control py-2">
        </div>
        <button type="submit" class="btn-tonal">
          <span class="material-symbols-outlined icono-20" aria-hidden="true">upload_file</span>
          <span data-etiqueta><%= gestor.tiene_permiso ? 'Reemplazar permiso' : 'Subir permiso' %></span>
        </button>
      </form>
      <noscript><p class="text-body-s text-error">Para subir el permiso el navegador debe tener JavaScript activo.</p></noscript>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
