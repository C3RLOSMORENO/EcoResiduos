<%- include('partials/header', { activeTab: 'gestores', titulo: 'Gestores', recorrido: recorrido }) %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="titulo-pagina">Gestores</h1>
      <p class="mt-1 text-body-l text-on-surface-variant">Empresas autorizadas que recolectan los residuos: revisa su permiso, sus materiales y su estado.</p>
    </div>
    <a href="/gestores/nuevo" class="btn-filled" data-recorrido="gestores-nuevo">
      <span class="material-symbols-outlined icono-20" aria-hidden="true">add</span>
      Nuevo gestor
    </a>
  </div>

  <form method="GET" action="/gestores" class="panel-filtros grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4" role="search" aria-label="Filtrar gestores">
    <div class="campo xl:col-span-2">
      <label for="filtroBusqueda" class="campo-etiqueta">Buscar</label>
      <input type="search" id="filtroBusqueda" name="q" value="<%= filtros.q %>" class="campo-control" aria-describedby="filtroBusquedaAyuda">
      <p id="filtroBusquedaAyuda" class="campo-ayuda">Razón social, NIT o material (código o nombre).</p>
    </div>
    <div class="campo">
      <label for="filtroMunicipio" class="campo-etiqueta">Municipio</label>
      <select id="filtroMunicipio" name="municipio" class="campo-control">
        <option value="">Todos los municipios</option>
        <% MUNICIPIOS.forEach(function (m) { %>
          <option value="<%= m %>" <%= filtros.municipio === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>
    </div>
    <div class="campo">
      <label for="filtroEstado" class="campo-etiqueta">Estado de verificación</label>
      <select id="filtroEstado" name="estado" class="campo-control">
        <option value="">Todos los estados</option>
        <% f.ESTADOS_GESTOR.forEach(function (e) { %>
          <option value="<%= e %>" <%= filtros.estado === e ? 'selected' : '' %>><%= f.etiquetaVerificacion(e) %></option>
        <% }); %>
      </select>
    </div>
    <label class="casilla md:col-span-2">
      <input type="checkbox" name="por_verificar" value="1" <%= filtros.porVerificar ? 'checked' : '' %>>
      Solo con materiales por verificar
    </label>
    <div class="flex flex-wrap items-center justify-end gap-2 md:col-span-2">
      <a href="/gestores" class="btn-text">Limpiar filtros</a>
      <button type="submit" class="btn-tonal">
        <span class="material-symbols-outlined icono-20" aria-hidden="true">filter_list</span>
        Filtrar
      </button>
    </div>
  </form>

  <% if (errorCarga) { %>
    <%- include('partials/componentes/estado-error', { titulo: 'No pudimos cargar los gestores.', detalle: errorCarga, reintentar: '/gestores' }) %>
  <% } else if (gestores.length === 0) { %>
    <div class="tarjeta">
      <% if (filtros.q || filtros.municipio || filtros.estado || filtros.porVerificar) { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'search_off', titulo: 'No encontramos gestores con esos filtros', texto: 'Prueba con otra búsqueda o limpia los filtros.', accion: { href: '/gestores', texto: 'Limpiar filtros' } }) %>
      <% } else { %>
        <%- include('partials/componentes/estado-vacio', { icono: 'domain_add', titulo: 'Aún no hay gestores registrados', texto: 'Registra el primero o espera a que una empresa se inscriba desde la app.', accion: { href: '/gestores/nuevo', texto: 'Nuevo gestor' } }) %>
      <% } %>
    </div>
  <% } else { %>
    <div data-recorrido="gestores-tabla">
      <div class="tabla-contenedor" role="region" aria-labelledby="captionGestores" tabindex="0">
        <table class="tabla">
          <caption id="captionGestores">Gestores registrados<%= filtros.estado ? ' · ' + f.etiquetaVerificacion(filtros.estado) : '' %><%= filtros.municipio ? ' · ' + filtros.municipio : '' %></caption>
          <thead>
            <tr>
              <%- include('partials/componentes/encabezado-orden', { campo: 'razon', texto: 'Gestor', ordenActual: filtros.orden, ruta: '/gestores' }) %>
              <th scope="col">Municipio</th>
              <th scope="col">Verificación</th>
              <th scope="col">Materiales</th>
              <th scope="col"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody>
            <% gestores.forEach(function (g) { %>
              <tr>
                <th scope="row">
                  <span class="flex items-start gap-3">
                    <%- include('partials/componentes/avatar', { nombre: g.razon_social, ruta: g.foto_perfil_path, tamano: 'md' }) %>
                    <span class="flex min-w-0 flex-col">
                      <a class="enlace" href="/gestores/<%= g.id %>"><%= g.razon_social || 'Sin razón social' %></a>
                      <span class="block text-body-s font-normal text-on-surface-variant">NIT <%= g.nit || 'sin dato' %></span>
                      <% if (g.estado_verificacion === 'PENDIENTE' && g.tiene_permiso) { %>
                        <span class="mt-1 flex flex-wrap items-center gap-2">
                          <span class="chip chip-cat-neutro"><span class="material-symbols-outlined" aria-hidden="true">smartphone</span>Registrado desde la app</span>
                          <a class="enlace text-body-s font-normal" href="/gestores/<%= g.id %>/permiso" target="_blank" rel="noopener noreferrer">Ver permiso<span class="sr-only"> de <%= g.razon_social %> (PDF, se abre en una pestaña nueva)</span></a>
                        </span>
                      <% } %>
                    </span>
                  </span>
                </th>
                <td><%= g.municipio ? f.capitalizar(g.municipio) : 'Sin dato' %></td>
                <td><%- include('partials/componentes/chip-estado', { estado: g.estado_verificacion, tipo: 'verificacion' }) %></td>
                <td>
                  <% if (g.materiales.length === 0) { %>
                    <span class="text-on-surface-variant">Sin materiales</span>
                  <% } else { %>
                    <ul class="flex flex-wrap gap-1" role="list" aria-label="Materiales de <%= g.razon_social %>">
                      <% g.materiales.slice(0, 4).forEach(function (m) { %>
                        <li><span class="chip chip-cat-<%= f.claseCategoria(m.categoria) %>" title="<%= m.nombre_comun %> · <%= f.etiquetaCategoria(m.categoria) %>"><%= m.codigo || m.nombre_comun %></span></li>
                      <% }); %>
                      <% if (g.materiales.length > 4) { %><li class="self-center text-body-s text-on-surface-variant">y <%= g.materiales.length - 4 %> más</li><% } %>
                    </ul>
                  <% } %>
                  <% if (g.materiales_por_verificar > 0) { %>
                    <span class="chip chip-estado-en-negociacion mt-1"><span class="material-symbols-outlined" aria-hidden="true">hourglass_top</span><%= g.materiales_por_verificar %> por verificar</span>
                  <% } %>
                </td>
                <td class="text-right">
                  <a href="/gestores/<%= g.id %>" class="btn-outlined btn-sm" aria-label="Ver detalle de <%= g.razon_social %>">Ver detalle</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <%- include('partials/componentes/paginacion', { pag, nombre: 'gestores' }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
