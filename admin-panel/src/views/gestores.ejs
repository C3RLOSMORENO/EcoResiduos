<%- include('partials/header', { activeTab: 'gestores' }) %>

<div class="max-w-7xl mx-auto space-y-6">
  <%- include('partials/alert') %>

  <!-- Encabezado y barra de acciones -->
  <div class="mb-6 space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <h1 class="text-xl font-semibold text-slate-900 dark:text-slate-100 tracking-tight">Gestores Ambientales</h1>
        <span class="inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:text-slate-400">
          <%= gestores ? gestores.length : 0 %>
        </span>
      </div>
      <button type="button" onclick="abrirModalUI('modalNuevoGestor')" class="btn-primary">
        <svg class="h-4 w-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Nuevo gestor</span>
      </button>
    </div>

    <!-- Barra de búsqueda y filtros -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="relative w-full max-w-sm">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
          <svg class="h-4 w-4 shrink-0" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <input type="text" id="buscadorGestores" placeholder="Buscar por razón social, NIT o material..." class="input-ui !pl-10">
      </div>
      <div class="flex items-center gap-2">
        <select id="filtroMunicipio" class="input-ui !w-auto">
          <option value="">Todos los municipios</option>
          <option value="Bucaramanga">Bucaramanga</option>
          <option value="Floridablanca">Floridablanca</option>
          <option value="Girón">Girón</option>
          <option value="Piedecuesta">Piedecuesta</option>
          <option value="Barrancabermeja">Barrancabermeja</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Tabla de datos -->
  <div class="tabla-container">
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr>
            <th scope="col" class="tabla-th pl-6">Gestor ambiental</th>
            <th scope="col" class="tabla-th">Municipio</th>
            <th scope="col" class="tabla-th">Verificación</th>
            <th scope="col" class="tabla-th">Materiales habilitados</th>
            <th scope="col" class="tabla-th pr-6 text-right"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <% if (gestores && gestores.length > 0) { %>
            <% gestores.forEach(g => { 
                const listaResiduos = g.residuos || g.materiales || [];
                const listaMaterialesTexto = listaResiduos.map(m => ((m.codigo || m) + ' ' + (m.nombre_comun || m.nombre || '') + ' ' + (m.categoria || ''))).join(' ');
                const estadoG = (g.estado_verificacion || 'APROBADO').toUpperCase();
                let badgeClassEst = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300';
                if (estadoG === 'PENDIENTE') badgeClassEst = 'bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300';
                else if (estadoG === 'RECHAZADO') badgeClassEst = 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300';
                else if (estadoG === 'SUSPENDIDO') badgeClassEst = 'bg-slate-200 text-slate-800 dark:bg-slate-700 dark:text-slate-300';
            %>
              <tr class="tabla-tr fila-gestor"
                  data-nit="<%= g.nit || '' %>"
                  data-razon="<%= g.razon_social || '' %>"
                  data-municipio="<%= g.municipio || '' %>"
                  data-direccion="<%= g.direccion || '' %>"
                  data-contacto="<%= (g.telefono_contacto || g.telefono || '') + ' ' + (g.email_contacto || g.email || '') + ' ' + (g.representante_legal || g.contacto || '') %>"
                  data-materiales="<%= listaMaterialesTexto %>">
                <td class="py-3.5 pl-6 pr-4">
                  <div class="text-sm font-semibold text-slate-800 dark:text-slate-100"><%= g.razon_social %></div>
                  <div class="text-xs text-slate-500 dark:text-slate-400">NIT: <%= g.nit %></div>
                </td>
                <td class="px-4 py-3.5 text-sm text-slate-700 dark:text-slate-300 capitalize">
                  <%= g.municipio ? g.municipio.toLowerCase() : 'Santander' %>
                </td>
                <td class="px-4 py-3.5 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wide uppercase <%= badgeClassEst %>">
                    <%= estadoG %>
                  </span>
                </td>
                <td class="px-4 py-3.5">
                  <div class="flex flex-wrap gap-1.5">
                    <% if (listaResiduos && listaResiduos.length > 0) { %>
                      <% listaResiduos.slice(0, 4).forEach(r => { 
                        const isObj = typeof r === 'object';
                        const codigo = isObj ? (r.codigo || r.nombre_comun || r.nombre) : r;
                        const cat = isObj ? (r.categoria || '') : '';
                        const nombre = isObj ? (r.nombre_comun || r.nombre || '') : '';
                        
                        // Función helper server-side para renderizado inicial
                        let colorClass = 'chip-respel-neutral';
                        const c = String(codigo).toUpperCase();
                        const catUpper = String(cat).toUpperCase();
                        if (c.startsWith('Y1') || c.startsWith('Y2') || c.startsWith('Y3') || catUpper.includes('BIOSANITARIO') || catUpper.includes('RIESGO_BIOLOGICO')) {
                          colorClass = 'chip-respel-bio';
                        } else if (c.startsWith('Y8') || c.startsWith('Y9') || c.startsWith('Y4') || c.startsWith('Y5') || c.startsWith('Y6') || c.startsWith('Y7') || catUpper.includes('PELIGROSO')) {
                          colorClass = 'chip-respel-oil';
                        } else if (c.startsWith('RAEE') || c.startsWith('RCD') || c.startsWith('Y26') || c.startsWith('Y29') || catUpper.includes('RAEE') || catUpper.includes('INDUSTRIAL') || catUpper.includes('RCD')) {
                          colorClass = 'chip-respel-raee';
                        } else if (c.startsWith('REC') || c.startsWith('ORG') || catUpper.includes('APROVECHABLE')) {
                          colorClass = 'chip-respel-eco';
                        }
                      %>
                        <span class="m3-chip !py-0.5 !px-2 !text-[11px] <%= colorClass %>"
                              title="<%= codigo %> - <%= nombre %> (<%= cat || 'RESPEL' %>)">
                          <%= codigo %>
                        </span>
                      <% }) %>
                      <% if (listaResiduos.length > 4) { %>
                        <span class="text-xs font-medium text-slate-400 self-center">+<%= listaResiduos.length - 4 %> más</span>
                      <% } %>
                    <% } else { %>
                      <span class="text-xs text-slate-400 italic">Sin materiales</span>
                    <% } %>
                    <% if (g.materiales_por_verificar > 0) { %>
                      <span class="m3-chip !py-0.5 !px-2 !text-[11px] bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300" title="Materiales declarados por el gestor que aún no se aprueban">
                        <%= g.materiales_por_verificar %> por verificar
                      </span>
                    <% } %>
                  </div>
                </td>
                <td class="py-3.5 pl-4 pr-6 text-right whitespace-nowrap">
                  <button type="button" onclick='abrirFichaGestorBtn(this)' data-gestor='<%= JSON.stringify(g) %>' class="btn-tonal">
                    Ver detalle
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="5" class="py-10 text-center text-xs text-slate-500">No hay gestores registrados.</td></tr>
          <% } %>
          <tr id="sinCoincidenciasGestor" class="hidden">
            <td colspan="5" class="py-10 text-center text-xs text-slate-500">
              No se encontraron gestores que coincidan con la búsqueda o filtro seleccionado.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Ficha de detalle (3 capas M3) -->
<div id="modalFichaGestor" role="dialog" aria-modal="true" class="modal-scrim">
  <div class="modal-dialog">
    <div class="modal-header">
      <div>
        <h2 id="fichaRazonSocial" class="text-lg font-semibold text-slate-900 dark:text-slate-100"></h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 capitalize">
          <span id="fichaMunicipioTexto"></span> Â· NIT: <span id="fichaNit"></span>
        </p>
      </div>
      <button type="button" onclick="cerrarModalUI('modalFichaGestor')" aria-label="Cerrar" class="btn-icon">
        <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="modal-body divide-y divide-slate-100 dark:divide-slate-800">
      <div class="flex items-center gap-4 py-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Representante legal / Contacto</p>
          <p id="fichaContacto" class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 font-medium"></p>
        </div>
      </div>

      <div class="flex items-center gap-4 py-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Teléfono</p>
          <p id="fichaTelefono" class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 font-medium"></p>
        </div>
      </div>

      <div class="flex items-center gap-4 py-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
          <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Correo corporativo</p>
          <p id="fichaEmail" class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 font-medium"></p>
        </div>
      </div>

      <div class="flex items-center justify-between gap-4 py-3">
        <div class="flex items-center gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Dirección operativa</p>
            <p id="fichaDireccion" class="text-sm text-slate-800 dark:text-slate-200 mt-0.5 font-medium"></p>
          </div>
        </div>
        <a id="fichaMapsLink" href="#" target="_blank" rel="noopener noreferrer" class="hidden btn-icon text-brand dark:text-emerald-400" title="Ver en Google Maps">
          <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </a>
      </div>

      <div class="pt-3">
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-2 font-medium">Residuos autorizados (RESPEL)</p>
        <div id="fichaListaResiduos" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
      </div>

      <!-- Auditoría de Estado de Verificación -->
      <div class="pt-4 mt-2 border-t border-slate-100 dark:border-slate-800">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-850 border border-slate-200/80 dark:border-slate-800 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Auditoría de Verificación:</span>
            <span id="fichaEstadoBadge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase"></span>
          </div>
          <form id="formCambiarEstado" action="" method="POST" class="flex items-center gap-2">
            <select id="selectCambiarEstado" name="estado" class="input-ui !text-xs !py-1.5 flex-1 font-semibold">
              <option value="APROBADO">APROBADO (Certificado)</option>
              <option value="PENDIENTE">PENDIENTE (En Revisión)</option>
              <option value="RECHAZADO">RECHAZADO</option>
              <option value="SUSPENDIDO">SUSPENDIDO</option>
            </select>
            <button type="submit" onclick="return confirm('Â¿Confirmas el cambio de estado de verificación de este gestor ambiental?');" class="btn-tonal !text-xs !h-9 !px-3 font-semibold whitespace-nowrap">
              Actualizar
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="modal-footer">
      <form id="formEliminarGestor" action="" method="POST" onsubmit="return confirm('Â¿Confirmas la baja de este gestor?');">
        <button type="submit" class="h-10 rounded-full px-4 text-xs font-medium text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition">Eliminar gestor</button>
      </form>
      <a id="btnEditarFicha" href="#" class="btn-primary">Editar entidad</a>
    </div>
  </div>
</div>

<!-- Modal: Registrar Gestor -->
<div id="modalNuevoGestor" role="dialog" aria-modal="true" class="modal-scrim">
  <div class="modal-dialog !max-w-2xl">
    <div class="modal-header">
      <div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Registrar Nuevo Gestor</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Ingresa los datos y selecciona los residuos autorizados</p>
      </div>
      <button type="button" onclick="cerrarModalUI('modalNuevoGestor')" aria-label="Cerrar" class="btn-icon">
        <svg class="h-5 w-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="modal-body max-h-[70vh] overflow-y-auto">
      <form id="formGestor" action="/gestores/guardar" method="POST" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">NIT *</label>
            <input type="text" name="nit" required placeholder="Ej. 900396512-1" data-format="nit" class="input-ui font-mono">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Municipio *</label>
            <input type="text" name="municipio" required placeholder="Ej. Bucaramanga" class="input-ui">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Razón Social *</label>
          <input type="text" name="razon_social" required placeholder="Nombre legal de la empresa" class="input-ui">
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Dirección Física *</label>
          <input type="text" name="direccion" required placeholder="Sede operativa (ej. Parque Industrial Bodega C-25)" class="input-ui">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Teléfono Principal *</label>
            <input type="text" name="telefono" required placeholder="Línea de contacto (ej. +57 607 6768585)" data-format="phone" class="input-ui">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Email Corporativo *</label>
            <input type="email" name="email" required placeholder="contacto@empresa.com" class="input-ui">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Representante Legal / Contacto</label>
          <input type="text" name="contacto" placeholder="Nombre completo" class="input-ui">
        </div>

        <!-- Selección de Residuos / Materiales Autorizados -->
        <div class="space-y-2 pt-3 border-t border-slate-100 dark:border-slate-800">
          <div class="flex items-center justify-between gap-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300">
              Residuos y Materiales Autorizados
            </label>
            <div class="flex items-center gap-3">
              <span id="contadorSeleccionadosNuevo" class="text-[11px] font-semibold text-brand dark:text-emerald-400">0 seleccionados</span>
              <button type="button" onclick="toggleTodosMaterialesNuevo(true)" class="text-[11px] text-slate-500 hover:text-brand dark:hover:text-emerald-400 underline">Todos</button>
              <span class="text-slate-300 dark:text-slate-600">|</span>
              <button type="button" onclick="toggleTodosMaterialesNuevo(false)" class="text-[11px] text-slate-500 hover:text-rose-600 underline">Ninguno</button>
            </div>
          </div>

          <!-- Buscador rápido dentro del modal de materiales -->
          <div class="relative">
            <input type="text" id="buscadorMaterialesNuevoGestor" placeholder="Filtrar materiales por código, nombre o categoría..." 
              class="w-full pl-8 pr-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-850 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-brand">
            <svg class="h-3.5 w-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>

          <% if (typeof materialesDisponibles !== 'undefined' && materialesDisponibles && materialesDisponibles.length > 0) { %>
            <div id="contenedorMaterialesNuevo" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-52 overflow-y-auto p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200/80 dark:border-slate-800">
              <% materialesDisponibles.forEach(function(mat) { 
                let badgeColor = 'chip-respel-neutral';
                const c = String(mat.codigo).toUpperCase();
                const catUpper = String(mat.categoria).toUpperCase();
                if (c.startsWith('Y1') || c.startsWith('Y2') || c.startsWith('Y3') || catUpper.includes('BIOSANITARIO') || catUpper.includes('RIESGO_BIOLOGICO')) {
                  badgeColor = 'chip-respel-bio';
                } else if (c.startsWith('Y8') || c.startsWith('Y9') || c.startsWith('Y4') || c.startsWith('Y5') || c.startsWith('Y6') || c.startsWith('Y7') || catUpper.includes('PELIGROSO')) {
                  badgeColor = 'chip-respel-oil';
                } else if (c.startsWith('RAEE') || c.startsWith('RCD') || c.startsWith('Y26') || c.startsWith('Y29') || catUpper.includes('RAEE') || catUpper.includes('INDUSTRIAL') || catUpper.includes('RCD')) {
                  badgeColor = 'chip-respel-raee';
                } else if (c.startsWith('REC') || c.startsWith('ORG') || catUpper.includes('APROVECHABLE')) {
                  badgeColor = 'chip-respel-eco';
                }
              %>
                <label for="nuevo_mat_<%= mat.id %>" class="item-material-check flex items-start gap-2.5 p-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-brand dark:hover:border-emerald-500 transition cursor-pointer select-none"
                       data-busqueda="<%= ((mat.codigo || '') + ' ' + (mat.nombre_comun || mat.nombre || '') + ' ' + (mat.categoria || '')).toLowerCase() %>">
                  <input type="checkbox" id="nuevo_mat_<%= mat.id %>" name="materiales_ids[]" value="<%= mat.id %>"
                    class="chk-material-nuevo mt-0.5 h-4 w-4 rounded border-slate-300 text-brand focus:ring-brand">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="font-mono text-xs font-bold text-slate-900 dark:text-slate-100"><%= mat.codigo %></span>
                      <span class="m3-chip !py-0.5 !px-2 !text-[10px] <%= badgeColor %>">
                        <%= mat.categoria || 'RESPEL' %>
                      </span>
                    </div>
                    <p class="text-xs text-slate-700 dark:text-slate-300 truncate mt-0.5 font-medium" title="<%= mat.nombre_comun || mat.nombre %>">
                      <%= mat.nombre_comun || mat.nombre %>
                    </p>
                  </div>
                </label>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-xs text-slate-400 italic p-3 rounded-xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800">No hay materiales registrados en el catálogo.</p>
          <% } %>
        </div>
      </form>
    </div>

    <div class="modal-footer">
      <button type="button" onclick="cerrarModalUI('modalNuevoGestor')" class="btn-tonal">Cancelar</button>
      <button type="submit" form="formGestor" class="btn-primary">Guardar gestor</button>
    </div>
  </div>
</div>

<script>
  function abrirFichaGestorBtn(btn) {
    try {
      const g = JSON.parse(btn.getAttribute('data-gestor'));
      document.getElementById('fichaRazonSocial').textContent = g.razon_social || 'Sin nombre';
      document.getElementById('fichaNit').textContent = g.nit || 'No registrado';
      document.getElementById('fichaMunicipioTexto').textContent = g.municipio ? g.municipio.toLowerCase() : 'santander';
      document.getElementById('fichaContacto').textContent = g.contacto || g.representante_legal || 'Sin registrar';
      document.getElementById('fichaTelefono').textContent = g.telefono || g.telefono_contacto || 'Sin registrar';
      document.getElementById('fichaEmail').textContent = g.email || g.email_contacto || 'Sin registrar';
      document.getElementById('fichaDireccion').textContent = g.direccion || 'No especificada';

      const maps = document.getElementById('fichaMapsLink');
      if (g.latitud && g.longitud) {
        maps.href = `https://www.google.com/maps?q=${g.latitud},${g.longitud}`;
        maps.classList.remove('hidden');
      } else if (g.direccion) {
        maps.href = `https://www.google.com/maps?q=${encodeURIComponent(g.direccion + ', ' + (g.municipio || '') + ', Santander')}`;
        maps.classList.remove('hidden');
      } else {
        maps.classList.add('hidden');
      }

      const contenedor = document.getElementById('fichaListaResiduos');
      contenedor.innerHTML = '';

      const listaResiduos = (g.residuos && g.residuos.length > 0) ? g.residuos : (g.materiales || []);
      if (listaResiduos && listaResiduos.length > 0) {
        listaResiduos.forEach(item => {
          const codigo = typeof item === 'object' ? (item.codigo || item.nombre_comun || item.nombre) : item;
          const nombre = typeof item === 'object' && (item.nombre || item.nombre_comun) ? (item.nombre || item.nombre_comun) : '';
          const colorClase = window.obtenerClaseResiduo ? window.obtenerClaseResiduo(codigo) : 'chip-respel-neutral';

          const card = document.createElement('div');
          card.className = `m3-chip ${colorClase} flex items-center justify-between gap-2 w-full p-2.5`;
          card.innerHTML = `
            <span class="font-bold shrink-0">${codigo}</span>
            <span class="truncate text-xs opacity-90">${nombre || 'Residuo Autorizado'}</span>
          `;
          contenedor.appendChild(card);
        });
      } else {
        contenedor.innerHTML = '<span class="text-xs text-slate-400 col-span-2">Sin materiales autorizados.</span>';
      }

      document.getElementById('btnEditarFicha').href = `/gestores/editar/${g.id}`;
      document.getElementById('formEliminarGestor').action = `/gestores/eliminar/${g.id}`;

      // Configurar controles de auditoría de verificación
      const estadoGestor = (g.estado_verificacion || 'APROBADO').toUpperCase();
      const badgeEstado = document.getElementById('fichaEstadoBadge');
      if (badgeEstado) {
        badgeEstado.textContent = estadoGestor;
        badgeEstado.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ' +
          (estadoGestor === 'APROBADO' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' :
           estadoGestor === 'PENDIENTE' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-300' :
           estadoGestor === 'RECHAZADO' ? 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300' :
           'bg-slate-200 text-slate-800 dark:bg-slate-700 dark:text-slate-300');
      }
      const selectEstado = document.getElementById('selectCambiarEstado');
      if (selectEstado) {
        selectEstado.value = estadoGestor;
      }
      const formEstado = document.getElementById('formCambiarEstado');
      if (formEstado) {
        formEstado.action = `/gestores/estado/${g.id}`;
      }

      window.abrirModalUI('modalFichaGestor');
    } catch (e) {
      console.error('Error al abrir detalle del gestor:', e);
    }
  }

  function toggleTodosMaterialesNuevo(check) {
    const checks = document.querySelectorAll('.chk-material-nuevo');
    checks.forEach(c => {
      const label = c.closest('.item-material-check');
      if (!label || label.style.display !== 'none') {
        c.checked = check;
      }
    });
    actualizarContadorMaterialesNuevo();
  }

  function actualizarContadorMaterialesNuevo() {
    const checked = document.querySelectorAll('.chk-material-nuevo:checked').length;
    const contador = document.getElementById('contadorSeleccionadosNuevo');
    if (contador) {
      contador.textContent = `${checked} seleccionado${checked === 1 ? '' : 's'}`;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Contador de materiales en modal nuevo gestor
    const chksNuevo = document.querySelectorAll('.chk-material-nuevo');
    chksNuevo.forEach(chk => {
      chk.addEventListener('change', actualizarContadorMaterialesNuevo);
    });

    // Buscador interno de materiales en modal nuevo gestor
    const buscadorMatNuevo = document.getElementById('buscadorMaterialesNuevoGestor');
    if (buscadorMatNuevo) {
      buscadorMatNuevo.addEventListener('input', (e) => {
        const query = (e.target.value || '').toLowerCase().trim();
        const items = document.querySelectorAll('#contenedorMaterialesNuevo .item-material-check');
        items.forEach(item => {
          const texto = item.getAttribute('data-busqueda') || '';
          if (!query || texto.includes(query)) {
            item.style.display = 'flex';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    // Buscador y filtro principal de gestores
    const inputBusqueda = document.getElementById('buscadorGestores');
    const selectMunicipio = document.getElementById('filtroMunicipio');
    const filas = document.querySelectorAll('.fila-gestor');
    const sinCoincidencias = document.getElementById('sinCoincidenciasGestor');

    function normalizarTexto(texto) {
      return (texto || '')
        .toString()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function filtrarTabla() {
      const query = normalizarTexto(inputBusqueda?.value);
      const municipioSeleccionado = normalizarTexto(selectMunicipio?.value);
      let visibles = 0;

      filas.forEach(fila => {
        const nit = normalizarTexto(fila.getAttribute('data-nit'));
        const razon = normalizarTexto(fila.getAttribute('data-razon'));
        const municipio = normalizarTexto(fila.getAttribute('data-municipio'));
        const direccion = normalizarTexto(fila.getAttribute('data-direccion'));
        const contacto = normalizarTexto(fila.getAttribute('data-contacto'));
        const materiales = normalizarTexto(fila.getAttribute('data-materiales'));

        const coincideTexto = !query || 
          nit.includes(query) || 
          razon.includes(query) || 
          municipio.includes(query) || 
          direccion.includes(query) || 
          contacto.includes(query) || 
          materiales.includes(query);

        const coincideMunicipio = !municipioSeleccionado || municipioSeleccionado === 'todos' || municipio === municipioSeleccionado;

        if (coincideTexto && coincideMunicipio) {
          fila.style.display = '';
          visibles++;
        } else {
          fila.style.display = 'none';
        }
      });

      if (sinCoincidencias) {
        sinCoincidencias.classList.toggle('hidden', visibles > 0 || filas.length === 0);
      }
    }

    inputBusqueda?.addEventListener('input', filtrarTabla);
    selectMunicipio?.addEventListener('change', filtrarTabla);
  });
</script>

<%- include('partials/footer') %>
