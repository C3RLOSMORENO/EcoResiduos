<%- include('partials/header', { activeTab: 'gestores', titulo: gestor.razon_social || 'Gestor' }) %>
<%
  const estado = gestor.estado_verificacion;
  const nombre = gestor.razon_social || 'este gestor';
  const totalMateriales = gestor.materiales.length;
  const porVerificar = gestor.materiales.filter(function (m) { return !m.verificado; });
%>

<div class="flex flex-col gap-6">
  <nav aria-label="Ruta de navegación" class="no-imprimir text-body-m">
    <ol class="flex flex-wrap items-center gap-1" role="list">
      <li><a class="enlace" href="/gestores">Gestores</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-on-surface-variant"><%= gestor.razon_social || 'Gestor' %></li>
    </ol>
  </nav>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex min-w-0 items-center gap-4">
      <%- include('partials/componentes/avatar', { nombre: gestor.razon_social, ruta: gestor.foto_perfil_path, tamano: 'lg' }) %>
      <div class="flex min-w-0 flex-col gap-2">
        <h1 class="titulo-pagina"><%= gestor.razon_social || 'Gestor sin razón social' %></h1>
        <div class="flex flex-wrap items-center gap-2">
          <%- include('partials/componentes/chip-estado', { estado: estado, tipo: 'verificacion' }) %>
          <% if (estado === 'PENDIENTE' && gestor.tiene_permiso) { %>
            <span class="chip chip-cat-neutro"><span class="material-symbols-outlined" aria-hidden="true">smartphone</span>Registrado desde la app</span>
          <% } %>
          <span class="text-body-m text-on-surface-variant">NIT <%= gestor.nit || 'sin dato' %></span>
        </div>
      </div>
    </div>
    <a href="/gestores/edit/<%= gestor.id %>" class="btn-outlined">
      <span class="material-symbols-outlined icono-20" aria-hidden="true">edit</span>
      Editar
    </a>
  </div>

  <section aria-labelledby="tituloEstado" class="tarjeta flex flex-col gap-4">
    <h2 id="tituloEstado" class="tarjeta-titulo">Estado de verificación</h2>
    <% if (estado === 'PENDIENTE') { %>
      <div class="nota nota-advertencia">
        <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
        <p>Revisa que el permiso ambiental corresponda a esta razón social y NIT y que autorice los materiales declarados. Quita los que no correspondan antes de aprobar: al aprobar, los materiales que queden se verifican y el gestor recibe el aviso.</p>
      </div>
    <% } %>
    <% const ultima = decisiones && decisiones[0]; %>
    <% if ((estado === 'RECHAZADO' || estado === 'SUSPENDIDO') && ultima && ultima.estado === estado && ultima.observacion) { %>
      <p class="text-body-m"><strong>Motivo:</strong> <%= ultima.observacion %></p>
    <% } %>
    <div class="flex flex-wrap gap-2">
      <% if (estado !== 'APROBADO') { %>
        <form action="/gestores/<%= gestor.id %>/estado" method="POST"
              data-confirmar-titulo="Aprobar gestor"
              data-confirmar="Aprobar a <%= f.finFrase(nombre) %> Podrá ver solicitudes de <%= totalMateriales === 1 ? 'su material' : 'sus ' + totalMateriales + ' materiales' %><%= porVerificar.length === 1 ? ' (el que está por verificar queda verificado)' : (porVerificar.length > 1 ? ' (los ' + porVerificar.length + ' por verificar quedan verificados)' : '') %>."
              data-confirmar-accion="Aprobar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="estado" value="APROBADO">
          <button type="submit" class="btn-filled" data-cargando="Aprobando…">
            <span class="material-symbols-outlined icono-20" aria-hidden="true">verified</span>
            <span data-etiqueta>Aprobar</span>
          </button>
        </form>
      <% } %>
      <% if (estado !== 'RECHAZADO' && estado !== 'APROBADO') { %>
        <form action="/gestores/<%= gestor.id %>/estado" method="POST"
              data-confirmar-titulo="Rechazar gestor"
              data-confirmar="Rechazar a <%= f.finFrase(nombre) %> No podrá ver solicitudes y recibirá el motivo en su notificación."
              data-confirmar-accion="Rechazar"
              data-confirmar-peligro
              data-confirmar-motivo>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="estado" value="RECHAZADO">
          <button type="submit" class="btn-peligro-outlined">
            <span class="material-symbols-outlined icono-20" aria-hidden="true">cancel</span>
            Rechazar
          </button>
        </form>
      <% } %>
      <% if (estado === 'APROBADO') { %>
        <form action="/gestores/<%= gestor.id %>/estado" method="POST"
              data-confirmar-titulo="Suspender gestor"
              data-confirmar="Suspender a <%= f.finFrase(nombre) %> Dejará de ver solicitudes nuevas hasta que lo vuelvas a aprobar."
              data-confirmar-accion="Suspender"
              data-confirmar-peligro
              data-confirmar-motivo>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="estado" value="SUSPENDIDO">
          <button type="submit" class="btn-peligro-outlined">
            <span class="material-symbols-outlined icono-20" aria-hidden="true">pause_circle</span>
            Suspender
          </button>
        </form>
      <% } %>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
    <section aria-labelledby="tituloDatos" class="tarjeta flex flex-col gap-4">
      <h2 id="tituloDatos" class="tarjeta-titulo">Datos de la empresa</h2>
      <dl class="grid grid-cols-1 gap-x-6 gap-y-3 md:grid-cols-2">
        <div><dt class="dato-etiqueta">Representante o contacto</dt><dd><%= f.textoODato(gestor.representante_legal) %></dd></div>
        <div><dt class="dato-etiqueta">Teléfono</dt><dd><% if (gestor.telefono_contacto) { %><a class="enlace" href="tel:<%= gestor.telefono_contacto.replace(/[^0-9+]/g, '') %>"><%= gestor.telefono_contacto %></a><% } else { %>Sin dato<% } %></dd></div>
        <div><dt class="dato-etiqueta">Correo</dt><dd class="break-all"><% if (gestor.email_contacto) { %><a class="enlace" href="mailto:<%= gestor.email_contacto %>"><%= gestor.email_contacto %></a><% } else { %>Sin dato<% } %></dd></div>
        <div><dt class="dato-etiqueta">Municipio</dt><dd><%= gestor.municipio ? f.capitalizar(gestor.municipio) : 'Sin dato' %></dd></div>
        <div class="md:col-span-2">
          <dt class="dato-etiqueta">Dirección</dt>
          <dd>
            <%= f.textoODato(gestor.direccion) %>
            <% if (ubicado) { %>
              <a class="enlace ml-1 inline-flex items-center gap-1" href="https://www.google.com/maps/search/?api=1&query=<%= gestor.latitud %>,<%= gestor.longitud %>" target="_blank" rel="noopener noreferrer">
                Ver en Google Maps<span class="material-symbols-outlined icono-18" aria-hidden="true">open_in_new</span><span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
              <span class="block text-body-s text-on-surface-variant">Ubicación calculada con datos de © OpenStreetMap contributors.</span>
            <% } else { %>
              <span class="block text-body-s text-on-surface-variant">Aún sin ubicar en el mapa: se ubica al aprobar o al cambiar la dirección.</span>
            <% } %>
          </dd>
        </div>
        <div><dt class="dato-etiqueta">Horario de atención</dt><dd><%= f.textoODato(gestor.horario) %></dd></div>
        <div><dt class="dato-etiqueta">Disponible para recolectar</dt><dd><%= gestor.disponible ? 'Sí' : 'No' %></dd></div>
        <div><dt class="dato-etiqueta">Cuenta en la app</dt><dd><%= gestor.tiene_cuenta ? 'Sí, vinculada' : 'No tiene' %></dd></div>
        <div><dt class="dato-etiqueta">Registro</dt><dd><%= f.fechaCorta(gestor.created_at) %></dd></div>
      </dl>
    </section>

    <div class="flex flex-col gap-6">
      <section aria-labelledby="tituloPermiso" class="tarjeta flex flex-col gap-4">
        <h2 id="tituloPermiso" class="tarjeta-titulo">Licencia o permiso ambiental</h2>
        <% if (gestor.tiene_permiso) { %>
          <p class="text-body-m text-on-surface-variant">El PDF se abre de forma segura en una pestaña nueva.</p>
          <p>
            <a href="/gestores/<%= gestor.id %>/permiso" target="_blank" rel="noopener noreferrer" class="btn-tonal">
              <span class="material-symbols-outlined icono-20" aria-hidden="true">picture_as_pdf</span>
              Ver permiso (PDF)<span class="sr-only"> de <%= nombre %>, se abre en una pestaña nueva</span>
            </a>
          </p>
        <% } else { %>
          <%- include('partials/componentes/estado-vacio', { icono: 'description', titulo: 'Sin permiso adjunto', texto: 'Los gestores creados desde el panel no traen permiso. Súbelo en PDF desde Editar.', accion: { href: '/gestores/edit/' + gestor.id + '#seccionPermiso', texto: 'Subir permiso' } }) %>
        <% } %>
      </section>

      <%
        const urlPortada = urlFotoPerfil(gestor.portada_path);
        const imagenes = [
          gestor.foto_perfil_path ? { valor: 'perfil', titulo: 'Quitar logo', detalle: 'El gestor verá sus iniciales hasta que suba otro desde la app.' } : null,
          gestor.portada_path ? { valor: 'portada', titulo: 'Quitar portada', detalle: 'La ficha vuelve al color de EcoResiduos hasta que suba otra desde la app.' } : null
        ].filter(Boolean);
      %>
      <% if (imagenes.length > 0) { %>
        <section aria-labelledby="tituloImagen" class="tarjeta flex flex-col gap-4">
          <div>
            <h2 id="tituloImagen" class="tarjeta-titulo">Logo y portada</h2>
            <p class="mt-1 text-body-m text-on-surface-variant">Los sube el gestor desde la app y los ven los ciudadanos. Quítalos si no corresponden a la empresa o son inapropiados.</p>
          </div>
          <div class="vista-ficha" aria-hidden="true">
            <div class="vista-ficha-portada">
              <% if (urlPortada) { %><img src="<%= urlPortada %>" alt="" loading="lazy" decoding="async" data-avatar><% } %>
            </div>
            <%- include('partials/componentes/avatar', { nombre: gestor.razon_social, ruta: gestor.foto_perfil_path, tamano: 'lg' }) %>
          </div>
          <div class="flex flex-wrap gap-2">
            <% imagenes.forEach(function (img) { %>
              <form action="/gestores/<%= gestor.id %>/imagenes/quitar" method="POST"
                    data-confirmar-titulo="<%= img.titulo %>"
                    data-confirmar="<%= img.titulo %> de <%= f.finFrase(nombre) %> <%= img.detalle %>"
                    data-confirmar-accion="Quitar"
                    data-confirmar-peligro>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="imagen" value="<%= img.valor %>">
                <button type="submit" class="btn-peligro-outlined btn-sm">
                  <span class="material-symbols-outlined icono-20" aria-hidden="true">delete</span>
                  <%= img.titulo %>
                </button>
              </form>
            <% }); %>
          </div>
        </section>
      <% } %>
    </div>
  </div>

  <section aria-labelledby="tituloMateriales" class="tarjeta flex flex-col gap-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="tituloMateriales" class="tarjeta-titulo">Materiales que recibe</h2>
      <% if (porVerificar.length > 0) { %>
        <form action="/gestores/<%= gestor.id %>/materiales/verificar-todos" method="POST"
              data-confirmar-titulo="Verificar todos los materiales"
              data-confirmar="Verificar <%= porVerificar.length === 1 ? 'el material por verificar' : 'los ' + porVerificar.length + ' materiales por verificar' %> de <%= f.finFrase(nombre) %> <%= estado === 'APROBADO' ? 'Empezará a ver sus solicitudes de inmediato.' : 'Los verá cuando la empresa esté aprobada.' %>"
              data-confirmar-accion="Verificar todos">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-tonal">
            <span class="material-symbols-outlined icono-20" aria-hidden="true">done_all</span>
            Verificar todos (<%= porVerificar.length %>)
          </button>
        </form>
      <% } %>
    </div>
    <% if (totalMateriales === 0) { %>
      <%- include('partials/componentes/estado-vacio', { icono: 'category', titulo: 'No tiene materiales', texto: 'Sin materiales verificados el gestor no ve ninguna solicitud. Agrégalos desde Editar.', accion: { href: '/gestores/edit/' + gestor.id, texto: 'Editar materiales' } }) %>
    <% } else { %>
      <p class="text-body-m text-on-surface-variant">
        <%= f.plural(totalMateriales - porVerificar.length, 'verificado', 'verificados') %><%= porVerificar.length > 0 ? ' · ' + porVerificar.length + ' por verificar (el gestor no ve sus solicitudes hasta verificarlos)' : '' %>.
      </p>
      <% Object.keys(gruposMateriales).forEach(function (cat) { %>
        <div class="flex flex-col gap-2">
          <h3 class="flex items-center gap-2 text-title-m"><%- include('partials/componentes/chip-categoria', { categoria: cat === 'SIN_CATEGORIA' ? '' : cat }) %></h3>
          <ul class="flex flex-col" role="list">
            <% gruposMateriales[cat].forEach(function (m) { %>
              <li class="flex flex-wrap items-center gap-3 border-t border-outline-variant py-3">
                <span class="min-w-0 flex-1">
                  <span class="font-semibold"><%= m.nombre_comun %></span>
                  <span class="text-body-s text-on-surface-variant"> · <%= m.codigo %></span>
                </span>
                <% if (m.verificado) { %>
                  <span class="chip chip-estado-recolectado"><span class="material-symbols-outlined" aria-hidden="true">verified</span>Verificado</span>
                <% } else { %>
                  <span class="chip chip-estado-en-negociacion"><span class="material-symbols-outlined" aria-hidden="true">hourglass_top</span>Por verificar</span>
                  <form action="/gestores/<%= gestor.id %>/materiales/<%= m.id %>/verificar" method="POST" class="m-0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-tonal btn-sm" aria-label="Verificar <%= m.nombre_comun %>">Verificar</button>
                  </form>
                  <form action="/gestores/<%= gestor.id %>/materiales/<%= m.id %>/quitar" method="POST" class="m-0"
                        data-confirmar-titulo="Quitar material"
                        data-confirmar="Quitar <%= m.nombre_comun %> de <%= f.finFrase(nombre) %> Dejará de ver solicitudes de este material."
                        data-confirmar-accion="Quitar"
                        data-confirmar-peligro>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-text btn-sm text-error" aria-label="Quitar <%= m.nombre_comun %>">Quitar</button>
                  </form>
                <% } %>
              </li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    <% } %>
  </section>

  <section aria-labelledby="tituloDecisiones" class="tarjeta flex flex-col gap-3">
    <h2 id="tituloDecisiones" class="tarjeta-titulo">Historial de decisiones</h2>
    <% if (decisiones === null || decisiones.length === 0) { %>
      <p class="text-body-m text-on-surface-variant">Aún no hay decisiones registradas para este gestor.</p>
    <% } else { %>
      <ol class="flex flex-col" role="list">
        <% decisiones.forEach(function (d) { %>
          <li class="flex flex-col gap-1 border-t border-outline-variant py-3">
            <span class="flex flex-wrap items-center gap-2">
              <%- include('partials/componentes/chip-estado', { estado: d.estado, tipo: 'verificacion' }) %>
              <span class="text-body-m"><%= f.fechaHora(d.created_at) %><%= d.creado_por ? ' · ' + d.creado_por : '' %></span>
            </span>
            <% if (d.observacion) { %><span class="text-body-m"><strong>Motivo:</strong> <%= d.observacion %></span><% } %>
          </li>
        <% }); %>
      </ol>
    <% } %>
  </section>

  <section aria-labelledby="tituloEliminar" class="tarjeta flex flex-col gap-3 no-imprimir">
    <h2 id="tituloEliminar" class="tarjeta-titulo">Eliminar gestor</h2>
    <% if (dependencias.tieneHistoria) { %>
      <p class="text-body-m text-on-surface-variant">
        No se puede eliminar porque tiene historia en EcoResiduos:
        <%= [
          dependencias.tieneCuenta ? 'cuenta vinculada en la app' : null,
          dependencias.postulaciones > 0 ? dependencias.postulaciones + ' postulación(es)' : null,
          dependencias.solicitudesAsignadas > 0 ? dependencias.solicitudesAsignadas + ' recolección(es) asignada(s)' : null
        ].filter(Boolean).join(', ') %>.
        <%= estado === 'SUSPENDIDO' ? 'Ya está suspendido.' : (estado === 'APROBADO' ? 'Si ya no debe operar, suspéndelo arriba.' : 'Si ya no debe operar, recházalo arriba.') %>
      </p>
    <% } else { %>
      <p class="text-body-m text-on-surface-variant">No tiene cuenta en la app, postulaciones ni recolecciones. Se puede eliminar.</p>
      <form action="/gestores/eliminar/<%= gestor.id %>" method="POST"
            data-confirmar-titulo="Eliminar gestor"
            data-confirmar="Eliminar a <%= nombre %> y <%= totalMateriales === 1 ? 'su material asignado' : 'sus ' + totalMateriales + ' materiales asignados' %>. Esta acción no se puede deshacer."
            data-confirmar-accion="Eliminar"
            data-confirmar-peligro>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-peligro-outlined">
          <span class="material-symbols-outlined icono-20" aria-hidden="true">delete</span>
          Eliminar gestor
        </button>
      </form>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
