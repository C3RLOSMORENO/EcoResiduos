{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "src/views/**,src/public/**,node_modules/chart.js/dist/**,node_modules/driver.js/dist/**,node_modules/@supabase/supabase-js/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
