PORT=3000
SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave pública (sb_publishable_… o anon) y llave de servidor (sb_secret_… o
# service_role). La de servidor nunca va en la app ni en el navegador.
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto para firmar los avisos que viajan en la URL (?msg=). Obligatorio con
# NODE_ENV=production: sin él el panel no arranca. Usa una cadena larga y
# aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_PANEL=

# Número de proxies delante del panel (1 en Render, Railway o detrás de Nginx).
# Déjalo vacío si el panel recibe las conexiones directamente. En Vercel no hace falta.
TRUST_PROXY=

# production activa HSTS, cookies Secure y el prefijo __Host- del token CSRF.
# En Vercel se pone sola.
NODE_ENV=development

# Asistente del panel (burbuja flotante). Llave gratuita de Google AI Studio:
# https://aistudio.google.com/apikey. Sin ella, el asistente aparece desactivado.
GEMINI_API_KEY=
# Modelos de Gemini en orden de preferencia, separados por coma; si uno está
# saturado o sin cuota se usa el siguiente. Vacío: gemini-3.5-flash,
# gemini-3.6-flash, gemini-3.5-flash-lite y gemini-3.1-flash-lite.
GEMINI_MODELO=
