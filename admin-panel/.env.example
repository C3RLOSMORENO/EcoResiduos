PORT=3000
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto para firmar los avisos que viajan en la URL (?msg=). Usa una cadena
# larga y aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_PANEL=

# Número de proxies delante del panel (1 en Render, Railway o detrás de Nginx).
# Déjalo vacío si el panel recibe las conexiones directamente.
TRUST_PROXY=

# production activa HSTS, cookies Secure y el prefijo __Host- del token CSRF.
NODE_ENV=development
