<%- include('partials/header', { activeTab: 'gestores' }) %>

    <div class="max-w-7xl mx-auto space-y-8">
        <%- include('partials/alert') %>

            <!-- Cabecera de Página -->
            <header
                class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-outline-variant/40 pb-6">
                <div>
                    <h2 class="text-2xl font-bold text-on-surface">Gestores Ambientales Certificados</h2>
                    <p class="text-sm text-on-surface-variant mt-1">Directorio de empresas autorizadas en Bucaramanga y
                        Santander</p>
                </div>
                <span
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-surface-container-high text-on-surface-variant">
                    Total: <%= gestores.length %> entidades
                </span>
            </header>

            <!-- Tarjeta Formulario (MD3 Outlined Card) -->
            <section aria-labelledby="form-title"
                class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm">
                <h3 id="form-title" class="text-lg font-semibold text-on-surface mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl" aria-hidden="true">add_circle</span>
                    <span>Registrar Nuevo Gestor</span>
                </h3>

                <form action="/gestores" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div>
                        <label for="nit" class="block text-xs font-medium text-on-surface-variant mb-1">NIT *</label>
                        <input type="text" id="nit" name="nit" required placeholder="900396512"
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label for="razon_social" class="block text-xs font-medium text-on-surface-variant mb-1">Razón
                            Social *</label>
                        <input type="text" id="razon_social" name="razon_social" required
                            placeholder="ALBEDO S.A.S. E.S.P."
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label for="municipio" class="block text-xs font-medium text-on-surface-variant mb-1">Municipio
                            *</label>
                        <input type="text" id="municipio" name="municipio" required value="BUCARAMANGA"
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div class="md:col-span-2">
                        <label for="direccion" class="block text-xs font-medium text-on-surface-variant mb-1">Dirección
                            Física *</label>
                        <input type="text" id="direccion" name="direccion" required
                            placeholder="Parque Industrial Bodega C-25"
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label for="representante_legal"
                            class="block text-xs font-medium text-on-surface-variant mb-1">Representante /
                            Contacto</label>
                        <input type="text" id="representante_legal" name="representante_legal"
                            placeholder="Nombre completo"
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label for="telefono_contacto"
                            class="block text-xs font-medium text-on-surface-variant mb-1">Teléfono Principal *</label>
                        <input type="tel" id="telefono_contacto" name="telefono_contacto" required
                            placeholder="6076768585"
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div>
                        <label for="email_contacto" class="block text-xs font-medium text-on-surface-variant mb-1">Email
                            Corporativo *</label>
                        <input type="email" id="email_contacto" name="email_contacto" required
                            placeholder="contacto@empresa.com"
                            class="w-full px-4 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="latitud" class="block text-xs font-medium text-on-surface-variant mb-1">Latitud
                                *</label>
                            <input type="number" step="any" id="latitud" name="latitud" required value="7.10971682"
                                class="w-full px-3 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                        </div>
                        <div>
                            <label for="longitud"
                                class="block text-xs font-medium text-on-surface-variant mb-1">Longitud *</label>
                            <input type="number" step="any" id="longitud" name="longitud" required value="-73.16346290"
                                class="w-full px-3 py-2.5 rounded-xl border border-outline bg-surface text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                        </div>
                    </div>

                    <div class="md:col-span-3 flex justify-end mt-2">
                        <button type="submit"
                            class="inline-flex items-center gap-2 bg-primary text-on-primary hover:opacity-90 font-medium px-6 py-3 rounded-full text-sm shadow-md transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                            <span class="material-symbols-outlined text-lg" aria-hidden="true">save</span>
                            <span>Guardar Gestor</span>
                        </button>
                    </div>
                </form>
            </section>

            <!-- Tarjeta Tabla (MD3 Surface Container) -->
            <section aria-labelledby="table-title"
                class="bg-surface rounded-3xl border border-outline-variant/60 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-outline-variant/40">
                    <h3 id="table-title" class="text-lg font-semibold text-on-surface">Listado de Gestores</h3>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead
                            class="bg-surface-container text-on-surface-variant text-xs font-semibold uppercase tracking-wider">
                            <tr>
                                <th scope="col" class="py-3.5 px-6">NIT</th>
                                <th scope="col" class="py-3.5 px-6">Razón Social</th>
                                <th scope="col" class="py-3.5 px-6">Municipio</th>
                                <th scope="col" class="py-3.5 px-6">Contacto</th>
                                <th scope="col" class="py-3.5 px-6 text-right">Acción</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20">
                            <% if (gestores && gestores.length> 0) { %>
                                <% gestores.forEach(function(g) { %>
                                    <tr class="hover:bg-surface-container-high/40 transition">
                                        <td class="py-4 px-6 font-mono text-xs font-medium text-on-surface">
                                            <%= g.nit %>
                                        </td>
                                        <td class="py-4 px-6">
                                            <span class="font-semibold text-on-surface block">
                                                <%= g.razon_social %>
                                            </span>
                                            <span class="text-xs text-on-surface-variant">
                                                <%= g.direccion %>
                                            </span>
                                        </td>
                                        <td class="py-4 px-6">
                                            <span
                                                class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-container-high text-on-surface-variant">
                                                <%= g.municipio %>
                                            </span>
                                        </td>
                                        <td class="py-4 px-6">
                                            <span class="block text-xs font-medium text-on-surface">
                                                <%= g.telefono_contacto %>
                                            </span>
                                            <span class="block text-xs text-on-surface-variant">
                                                <%= g.email_contacto %>
                                            </span>
                                        </td>
                                        <td class="py-4 px-6 text-right">
                                            <form action="/gestores/delete/<%= g.id %>" method="POST"
                                                onsubmit="return confirm('¿Seguro que deseas eliminar este gestor?');"
                                                class="inline">
                                                <button type="submit" aria-label="Eliminar gestor <%= g.razon_social %>"
                                                    class="p-2 text-red-600 hover:bg-red-50 rounded-full transition focus:outline-none focus:ring-2 focus:ring-red-500">
                                                    <span class="material-symbols-outlined text-lg"
                                                        aria-hidden="true">delete</span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="py-12 text-center text-on-surface-variant">
                                                    No hay gestores disponibles en la base de datos.
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
    </div>

    <%- include('partials/footer') %>