<%- include('partials/header', { activeTab: 'autoridades' }) %>

<div class="max-w-4xl mx-auto space-y-6">
    <%- include('partials/alert') %>

    <!-- Cabecera de edición y botón para retornar a autoridades -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
        <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-1">
                <a href="/autoridades" class="hover:text-brand dark:hover:text-emerald-400 transition flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    <span>Volver a Autoridades Locales</span>
                </a>
                <span>/</span>
                <span class="text-slate-800 dark:text-slate-200">Edición</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">Editar Autoridad Ambiental</h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">Actualiza los datos institucionales, contacto y sede de control</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono font-bold bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
                ID: <%= autoridad.id %>
            </span>
        </div>
    </header>

    <!-- Tarjeta de edición institucional -->
    <section aria-labelledby="edit-aut-title" class="m3-surface-container p-6 md:p-8">
        <h2 id="edit-aut-title" class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 mb-6 flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-4">
            <span class="material-symbols-outlined text-brand dark:text-emerald-400 text-xl" aria-hidden="true">edit_note</span>
            <span>Modificar Información Institucional</span>
        </h2>

        <form action="/autoridades/edit/<%= autoridad.id %>" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="nombre" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Nombre Institucional *</label>
                    <input type="text" id="nombre" name="nombre" required value="<%= autoridad.nombre %>"
                        placeholder="Corporación Autónoma Regional..."
                        class="input-ui">
                </div>

                <div>
                    <label for="sigla" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Sigla Oficial *</label>
                    <input type="text" id="sigla" name="sigla" required value="<%= autoridad.sigla %>"
                        placeholder="CDMB, AMB, CAS"
                        data-format="uppercase"
                        class="input-ui uppercase font-mono font-bold">
                </div>

                <div class="md:col-span-2">
                    <label for="jurisdiccion" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Jurisdicción Territorial *</label>
                    <input type="text" id="jurisdiccion" name="jurisdiccion" required value="<%= autoridad.jurisdiccion %>"
                        placeholder="Área metropolitana y municipios de la meseta"
                        class="input-ui">
                </div>

                <div>
                    <label for="telefono" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Teléfono Institucional *</label>
                    <input type="text" id="telefono" name="telefono" required value="<%= autoridad.telefono %>"
                        placeholder="6076346100"
                        data-format="phone"
                        class="input-ui">
                </div>

                <div>
                    <label for="email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Correo Electrónico *</label>
                    <input type="email" id="email" name="email" required value="<%= autoridad.email %>"
                        placeholder="contacto@cdmb.gov.co"
                        class="input-ui">
                </div>

                <div>
                    <label for="sitio_web" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Portal Web Oficial *</label>
                    <input type="url" id="sitio_web" name="sitio_web" required value="<%= autoridad.sitio_web %>"
                        placeholder="https://www.cdmb.gov.co"
                        class="input-ui">
                </div>

                <div>
                    <label for="direccion" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Dirección Sede Principal *</label>
                    <input type="text" id="direccion" name="direccion" required value="<%= autoridad.direccion %>"
                        placeholder="Carrera 23 # 37-63, Bucaramanga"
                        class="input-ui">
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <a href="/autoridades" class="btn-tonal !h-10 !px-5">
                    <span>Cancelar</span>
                </a>
                <button type="submit" class="btn-primary">
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">save</span>
                    <span>Guardar Cambios</span>
                </button>
            </div>
        </form>
    </section>
</div>

<%- include('partials/footer') %>
