<!DOCTYPE html>
<html lang="es" class="h-full bg-surface">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Acceso al panel administrativo de EcoResiduos Santander">
    <title>Iniciar Sesión - EcoManager Panel Santander</title>

    <!-- Material Symbols & Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- Tailwind CSS CDN configurado con paleta Material Design 3 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                    },
                    colors: {
                        primary: '#006D44',
                        'on-primary': '#FFFFFF',
                        'primary-container': '#91F7BD',
                        'on-primary-container': '#002111',
                        surface: '#FBFDF8',
                        'surface-container': '#EDF2EA',
                        'surface-container-high': '#E7ECE4',
                        'on-surface': '#191C1A',
                        'on-surface-variant': '#404943',
                        outline: '#707973',
                        'outline-variant': '#BFC9C2',
                    }
                }
            }
        }
    </script>
</head>

<body class="min-h-full flex items-center justify-center bg-surface-container p-4 sm:p-6 lg:p-8 font-sans text-on-surface antialiased">
    <main class="w-full max-w-md">
        <!-- Tarjeta Tonal Material Design 3 -->
        <div class="bg-surface rounded-3xl border border-outline-variant/60 shadow-xl shadow-black/5 p-8 sm:p-10 transition-all">
            
            <!-- Cabecera / Identidad Visual -->
            <div class="flex flex-col items-center text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-primary-container flex items-center justify-center mb-4 shadow-sm">
                    <span class="material-symbols-outlined text-primary text-4xl" aria-hidden="true">recycling</span>
                </div>
                <h1 class="text-2xl font-bold text-on-surface tracking-tight">EcoManager</h1>
                <p class="text-xs font-semibold text-primary uppercase tracking-wider mt-1">Panel Santander</p>
                <p class="text-sm text-on-surface-variant mt-2">Ingresa tus credenciales para administrar el directorio de residuos y gestores autorizados.</p>
            </div>

            <!-- Alertas y Feedback -->
            <%- include('partials/alert') %>

            <!-- Formulario de Autenticación -->
            <form action="/auth/login" method="POST" class="space-y-6" novalidate>
                <!-- Campo: Correo Electrónico -->
                <div>
                    <label for="email" class="block text-xs font-medium text-on-surface-variant mb-1.5">
                        Correo Electrónico <span class="text-red-600" aria-hidden="true">*</span>
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-on-surface-variant">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
                        </div>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required 
                            autocomplete="email"
                            placeholder="admin@ecoresiduos.org"
                            class="w-full pl-11 pr-4 py-3 rounded-2xl border border-outline bg-surface text-on-surface text-sm placeholder:text-outline/70 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 focus:border-primary transition-all duration-200"
                        >
                    </div>
                </div>

                <!-- Campo: Contraseña con Toggle Mostrar/Ocultar -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="block text-xs font-medium text-on-surface-variant">
                            Contraseña <span class="text-red-600" aria-hidden="true">*</span>
                        </label>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-on-surface-variant">
                            <span class="material-symbols-outlined text-xl" aria-hidden="true">lock</span>
                        </div>
                        <input 
                            type="password" 
                            id="password" 
                            name="password" 
                            required 
                            autocomplete="current-password"
                            placeholder="••••••••"
                            class="w-full pl-11 pr-12 py-3 rounded-2xl border border-outline bg-surface text-on-surface text-sm placeholder:text-outline/70 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 focus:border-primary transition-all duration-200"
                        >
                        <button 
                            type="button" 
                            id="toggle-password-btn" 
                            aria-label="Mostrar contraseña" 
                            aria-controls="password" 
                            aria-pressed="false"
                            class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-on-surface-variant hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-1 rounded-xl transition-colors"
                        >
                            <span class="material-symbols-outlined text-xl select-none" id="toggle-password-icon" aria-hidden="true">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Botón de Envío (MD3 Filled Button) -->
                <div>
                    <button 
                        type="submit" 
                        id="login-submit-btn"
                        class="w-full flex items-center justify-center gap-2 py-3.5 px-6 rounded-full bg-primary text-on-primary font-medium text-sm hover:bg-primary/90 active:scale-[0.99] shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                    >
                        <span class="material-symbols-outlined text-xl" aria-hidden="true">login</span>
                        <span>Ingresar al Panel</span>
                    </button>
                </div>
            </form>

            <!-- Pie de Tarjeta / Información de Seguridad -->
            <div class="mt-8 pt-6 border-t border-outline-variant/40 text-center">
                <p class="text-xs text-on-surface-variant flex items-center justify-center gap-1.5">
                    <span class="material-symbols-outlined text-base text-primary" aria-hidden="true">verified_user</span>
                    <span>Acceso protegido con cifrado SSL y Supabase Auth</span>
                </p>
            </div>
        </div>

        <!-- Pie de Página Externo -->
        <p class="text-center text-xs text-on-surface-variant/80 mt-6">
            &copy; <%= new Date().getFullYear() %> EcoResiduos Santander • Gestión Integral de Residuos
        </p>
    </main>

    <!-- Script de interactividad y accesibilidad WCAG -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const togglePasswordBtn = document.getElementById('toggle-password-btn');
            const passwordInput = document.getElementById('password');
            const togglePasswordIcon = document.getElementById('toggle-password-icon');

            if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
                togglePasswordBtn.addEventListener('click', () => {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    const newType = isPassword ? 'text' : 'password';
                    
                    passwordInput.setAttribute('type', newType);
                    togglePasswordBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                    togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
                    togglePasswordIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
                    
                    // Mantener el foco en el input para accesibilidad
                    passwordInput.focus();
                });
            }
        });
    </script>
</body>

</html>
